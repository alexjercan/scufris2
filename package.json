{
  "name": "scufris2",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "npm run version:check && npm run typecheck && npm test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "./scripts/scufris-dev",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "version:check": "python3 tools/release/check_versions.py"
  },
  "pi": {
    "extensions": [
      "./agent/extensions/scufris/workflow/index.ts",
      "./agent/extensions/scufris/response.ts",
      "./agent/extensions/scufris/calm.ts",
      "./agent/extensions/scufris/service/index.ts"
    ],
    "skills": [
      "./agent/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "24.12.4",
    "prettier": "3.5.3",
    "typescript": "5.9.3"
  }
}
