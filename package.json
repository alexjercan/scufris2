{
  "name": "scufris2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "./scripts/scufris-dev",
    "dev:voice": "./scripts/scufris-dev --voice",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/scufris/identity.ts",
      "./extensions/scufris/calm.ts",
      "./extensions/scufris/agents.ts",
      "./extensions/scufris/widgets.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "24.12.4",
    "prettier": "3.5.3",
    "typescript": "5.9.3"
  }
}
