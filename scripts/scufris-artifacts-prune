#!/usr/bin/env python3
"""Remove bounded orphan Scufris artifact sidecars."""

from __future__ import annotations

import os
import re
import shutil
import stat
import sys
from pathlib import Path

MAX_SIDECARS = 4096
OWNED_FILE = re.compile(r"[a-f0-9]{24}\.(?:md|json)\Z")


def session_root() -> Path:
    configured = os.environ.get("PI_CODING_AGENT_SESSION_DIR")
    if configured:
        return Path(configured).expanduser()
    return Path.home() / ".pi" / "agent" / "sessions"


def safe_orphan(sidecar: Path) -> bool:
    info = sidecar.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        return False
    if stat.S_IMODE(info.st_mode) != 0o700:
        return False
    session = Path(str(sidecar)[: -len(".scufris")])
    if session.exists() or session.is_symlink():
        return False
    for item in sidecar.iterdir():
        item_info = item.lstat()
        if (
            not OWNED_FILE.fullmatch(item.name)
            or not stat.S_ISREG(item_info.st_mode)
            or item_info.st_uid != os.getuid()
            or stat.S_IMODE(item_info.st_mode) != 0o600
        ):
            return False
    return True


def main() -> int:
    root = session_root()
    if not root.exists() or root.is_symlink() or not root.is_dir():
        return 0
    sidecars: list[Path] = []
    for directory, names, _files in os.walk(root, followlinks=False):
        for name in names:
            if name.endswith(".jsonl.scufris"):
                sidecars.append(Path(directory) / name)
                if len(sidecars) > MAX_SIDECARS:
                    print("scufris-artifacts-prune: scan limit exceeded", file=sys.stderr)
                    return 2
    removed = 0
    for sidecar in sidecars:
        try:
            if safe_orphan(sidecar):
                shutil.rmtree(sidecar)
                removed += 1
        except OSError:
            continue
    print(f"removed {removed} orphan artifact sidecar(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
