#!/usr/bin/env bash

set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
session_root="${XDG_STATE_HOME:-$HOME/.local/state}/scufris/dev-sessions"
if [[ -z "${SCUFRIS_PROJECT_ROOTS+x}" ]]; then
  export SCUFRIS_PROJECT_ROOTS='["~/personal","~/work","~/third-party"]'
fi
mkdir -p -- "$session_root"
chmod 0700 "$session_root"

repository_npm_bin="$root/node_modules/.bin"
repository_npm_bin_physical=""
if [[ -d "$repository_npm_bin" ]]; then
  repository_npm_bin_physical="$(CDPATH='' cd -- "$repository_npm_bin" && pwd -P)"
fi

path_remainder="$PATH"
system_path_entries=()
while true; do
  if [[ "$path_remainder" == *:* ]]; then
    entry="${path_remainder%%:*}"
    path_remainder="${path_remainder#*:}"
    final_entry=false
  else
    entry="$path_remainder"
    final_entry=true
  fi

  is_repository_npm_bin=false
  if [[ "$entry" == "$repository_npm_bin" || "$entry" == "$repository_npm_bin/" ]]; then
    is_repository_npm_bin=true
  elif [[ -n "$entry" && -n "$repository_npm_bin_physical" && -d "$entry" ]]; then
    entry_physical="$(CDPATH='' cd -- "$entry" && pwd -P)"
    if [[ "$entry_physical" == "$repository_npm_bin_physical" ]]; then
      is_repository_npm_bin=true
    fi
  fi
  if [[ "$is_repository_npm_bin" == false ]]; then
    system_path_entries+=("$entry")
  fi

  if [[ "$final_entry" == true ]]; then
    break
  fi
done
system_path="$(IFS=:; printf %s "${system_path_entries[*]}")"
if ! system_pi="$(PATH="$system_path" type -P pi)"; then
  printf 'scufris-dev: system Pi is unavailable\n' >&2
  exit 2
fi
export PATH="$system_path"

extensions=(
  "$root/extensions/scufris/workflow/index.ts"
  "$root/extensions/scufris/response.ts"
  "$root/extensions/scufris/calm.ts"
  "$root/extensions/scufris/service/index.ts"
  "$root/extensions/scufris/widgets/index.ts"
)
skills=(
  "$root/skills/workflow"
  "$root/skills/widgets"
)
# No --voice flag and no Piper. This process makes no sound whatever it is
# given, so there is nothing here for a voice mode to turn on. To hear a
# working tree, run the companion with a synthesiser; see the maintenance
# chapter.
unset SCUFRIS_PIPER_MODEL SCUFRIS_PIPER_CONFIG

args=()
for extension in "${extensions[@]}"; do
  args+=(--extension "$extension")
done
for skill in "${skills[@]}"; do
  args+=(--skill "$skill")
done

export SCUFRIS_ROLE=orchestrator
exec "$system_pi" "${args[@]}" --session-dir "$session_root" --continue "$@"
