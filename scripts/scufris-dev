#!/usr/bin/env bash
# One working-tree Scufris in a terminal, on a session directory of its own so
# a development run never lands in the deployed conversation.
#
# The extensions and the Pi selection are `scufris-agent`'s, which is the same
# launcher `scufris-staging` hands to the service. What is added here is the
# terminal's part: which sessions, and to continue the newest.

set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
session_root="${XDG_STATE_HOME:-$HOME/.local/state}/scufris/dev-sessions"
mkdir -p -- "$session_root"
chmod 0700 "$session_root"

exec "$root/scripts/scufris-agent" \
  --session-dir "$session_root" --continue "$@"
