#!/usr/bin/env python3
"""Inspect stored Scufris jobs without changing them."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import unicodedata
from pathlib import Path
from typing import Any

JOB_ID = re.compile(r"^[a-f0-9]{12}$")
JOB_ID_PREFIX = re.compile(r"^[a-f0-9]{1,12}$")
ARCHIVE_DIR = "_archive"
TABLE_FIELDS = (
    ("ID", 12),
    ("STATE", 10),
    ("LIVE", 7),
    ("PROJECT", 24),
    ("WORKSPACE", 9),
    ("WORKER", 28),
    ("SUMMARY", 60),
)


class CliError(Exception):
    """An expected lookup or inspection error."""


def jobs_root() -> Path:
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return state / "scufris" / "jobs"


def helper_path() -> Path:
    return Path(__file__).resolve().parents[1] / "tools" / "jobs" / "scufris-jobs"


def helper_call(command: str, request: dict[str, Any], about: str) -> dict[str, Any]:
    try:
        completed = subprocess.run(
            [str(helper_path()), command],
            input=json.dumps(request),
            text=True,
            capture_output=True,
            check=False,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise CliError(f"cannot {about}: {error}") from error
    try:
        envelope = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise CliError(f"cannot {about}: invalid helper response") from error
    if not isinstance(envelope, dict):
        raise CliError(f"cannot {about}: invalid helper response")
    if completed.returncode != 0 or not envelope.get("ok"):
        message = envelope.get("error", "the helper refused")
        raise CliError(f"cannot {about}: {message}")
    result = envelope.get("result")
    if not isinstance(result, dict):
        raise CliError(f"cannot {about}: invalid helper result")
    return result


def inspect(job_id: str, *, full: bool = False) -> dict[str, Any]:
    request: dict[str, Any] = {"job_id": job_id}
    if full:
        request.update(
            {
                "include_report": True,
                "include_context": True,
                "include_prompt": True,
            }
        )
    return helper_call("inspect", request, f"inspect job {job_id}")


def history(since: str | None, limit: int | None) -> dict[str, Any]:
    """Every job record since a timestamp, archived ones included.

    The archive is where a finished workflow goes, so every other listing here
    is about work that is still live. This is the one that answers what landed,
    and each record carries the receipt that was measured about it.
    """
    request: dict[str, Any] = {}
    if since is not None:
        request["since"] = since
    if limit is not None:
        request["limit"] = limit
    return helper_call("history", request, "read the job history")


def scan_job_ids(root: Path) -> list[str]:
    try:
        with os.scandir(root) as entries:
            return sorted(
                entry.name
                for entry in entries
                if JOB_ID.fullmatch(entry.name) and entry.is_dir(follow_symlinks=False)
            )
    except FileNotFoundError:
        return []
    except OSError as error:
        raise CliError(f"cannot list jobs: {error}") from error


def job_ids(*, archived: bool = False) -> list[str]:
    active = scan_job_ids(jobs_root())
    if not archived:
        return active
    return sorted({*active, *scan_job_ids(jobs_root() / ARCHIVE_DIR)})


def invalid_job(job_id: str, error: CliError) -> dict[str, Any]:
    return {
        "job_id": job_id,
        "state": "invalid",
        "summary": str(error),
        "window_alive": False,
    }


def all_jobs(*, archived: bool = False) -> list[dict[str, Any]]:
    jobs: list[dict[str, Any]] = []
    for job_id in job_ids(archived=archived):
        try:
            jobs.append(inspect(job_id))
        except CliError as error:
            jobs.append(invalid_job(job_id, error))
    return jobs


def resolve_job_id(value: str) -> str:
    if not JOB_ID_PREFIX.fullmatch(value):
        raise CliError("job ID must be 1 to 12 lowercase hexadecimal characters")
    matches = [job_id for job_id in job_ids(archived=True) if job_id.startswith(value)]
    if not matches:
        raise CliError(f"job ID not found: {value}")
    if len(matches) > 1:
        raise CliError(f"ambiguous job ID {value}: {', '.join(matches)}")
    return matches[0]


def escaped_control(character: str) -> str:
    codepoint = ord(character)
    if codepoint <= 0xFF:
        return f"\\x{codepoint:02x}"
    if codepoint <= 0xFFFF:
        return f"\\u{codepoint:04x}"
    return f"\\U{codepoint:08x}"


def terminal_safe(value: Any, *, multiline: bool = False) -> str:
    text = str(value if value is not None else "-")
    rendered: list[str] = []
    for character in text:
        if multiline and character == "\n":
            rendered.append(character)
        elif unicodedata.category(character).startswith("C"):
            rendered.append(escaped_control(character))
        else:
            rendered.append(character)
    return "".join(rendered)


def clean_text(value: Any) -> str:
    return " ".join(terminal_safe(value).split())


def display_width(value: str) -> int:
    return sum(
        0
        if unicodedata.combining(character)
        else 2
        if unicodedata.east_asian_width(character) in {"W", "F"}
        else 1
        for character in value
    )


def clipped(value: Any, width: int) -> str:
    text = clean_text(value)
    if display_width(text) <= width:
        return text
    available = width - 3
    rendered: list[str] = []
    used = 0
    for character in text:
        cells = display_width(character)
        if used + cells > available:
            break
        rendered.append(character)
        used += cells
    return "".join(rendered) + "..."


def padded(value: Any, width: int) -> str:
    text = clipped(value, width)
    return text + " " * (width - display_width(text))


def table_row(job: dict[str, Any]) -> str:
    values = (
        job.get("job_id", "unknown"),
        job.get("state") or "unknown",
        "running" if job.get("window_alive") else "stopped",
        job.get("project") or "general",
        job.get("workspace") or "unknown",
        f"{job.get('harness') or 'unknown'}/{job.get('model') or 'unknown'}",
        job.get("summary") or "-",
    )
    cells = [
        padded(value, width)
        for value, (_, width) in zip(values, TABLE_FIELDS, strict=True)
    ]
    return "  ".join(cells).rstrip()


def print_table(jobs: list[dict[str, Any]]) -> None:
    if not jobs:
        print("No Scufris jobs.")
        return
    print(
        "Columns: ID=job ID; STATE=latest event; LIVE=worker pane; "
        "PROJECT; WORKSPACE; WORKER=harness/model; SUMMARY=latest event summary."
    )
    print("  ".join(f"{name:<{width}}" for name, width in TABLE_FIELDS).rstrip())
    print("  ".join("-" * width for _, width in TABLE_FIELDS).rstrip())
    for job in jobs:
        print(table_row(job))


HISTORY_FIELDS = (
    ("CREATED", 20),
    ("ID", 12),
    ("STATE", 10),
    ("PLACE", 8),
    ("PROJECT", 20),
    ("WORKSPACE", 9),
    ("RECEIPT", 40),
)


def receipt_line(job: dict[str, Any]) -> str:
    """What the receipt says about this job, in its own words.

    Measured, never judged. `sentences` is what the receipt already decided to
    say, so nothing here rewrites it.
    """
    receipt = job.get("receipt")
    if not isinstance(receipt, dict):
        return "(none measured)"
    sentences = receipt.get("sentences")
    if isinstance(sentences, list) and sentences:
        return "; ".join(str(item) for item in sentences)
    facts = receipt.get("facts")
    if isinstance(facts, dict) and facts.get("landed") is True:
        return "landed"
    return "measured, nothing to flag"


def history_row(job: dict[str, Any]) -> str:
    values = (
        job.get("created_at") or "-",
        job.get("job_id", "unknown"),
        job.get("state") or "unknown",
        "archived" if job.get("archived") else "live",
        job.get("project") or "general",
        job.get("workspace") or "unknown",
        receipt_line(job),
    )
    cells = [
        padded(value, width)
        for value, (_, width) in zip(values, HISTORY_FIELDS, strict=True)
    ]
    return "  ".join(cells).rstrip()


def print_history(result: dict[str, Any]) -> None:
    jobs = result.get("jobs")
    jobs = jobs if isinstance(jobs, list) else []
    if not jobs:
        print("No Scufris jobs in that window.")
        return
    print(
        "Columns: CREATED; ID=job ID; STATE=latest event; PLACE=live or "
        "archived; PROJECT; WORKSPACE; RECEIPT=what was measured."
    )
    print("  ".join(f"{name:<{width}}" for name, width in HISTORY_FIELDS).rstrip())
    print("  ".join("-" * width for _, width in HISTORY_FIELDS).rstrip())
    for job in jobs:
        print(history_row(job))


def print_field(label: str, value: Any) -> None:
    print(f"{label}: {clean_text(value)}")


def print_block(label: str, value: Any) -> None:
    print(f"{label}:")
    text = terminal_safe(value or "", multiline=True)
    if text:
        print(text, end="" if text.endswith("\n") else "\n")
    else:
        print("  (none)")


def print_receipt(receipt: Any, count: Any) -> None:
    """Prints measured facts. `false` is a measurement; a blank is not."""
    if not isinstance(receipt, dict):
        print("Receipt: (none measured)")
        return
    total = count if isinstance(count, int) else 1
    print(
        f"Receipt: measured {clean_text(receipt.get('measured_at'))} "
        f"on {clean_text(receipt.get('trigger'))} ({total} recorded)"
    )
    facts = receipt.get("facts")
    unavailable = receipt.get("unavailable")
    unavailable = unavailable if isinstance(unavailable, dict) else {}
    if isinstance(facts, dict) and facts:
        for name in sorted(facts):
            value = facts[name]
            reason = unavailable.get(name)
            if value is None and reason:
                print(f"  {name}: unknown ({clean_text(reason)})")
            elif isinstance(value, list):
                print(f"  {name}: {clean_text(', '.join(map(str, value)) or 'none')}")
            else:
                print(f"  {name}: {clean_text(json.dumps(value))}")
    for name in sorted(
        set(unavailable) - set(facts if isinstance(facts, dict) else {})
    ):
        print(f"  {name}: unknown ({clean_text(unavailable[name])})")
    claims = receipt.get("claims")
    if isinstance(claims, list) and claims:
        print("  Claims:")
        for claim in claims:
            if not isinstance(claim, dict):
                continue
            print(
                f"    {clean_text(claim.get('claim'))}: "
                f"{clean_text(claim.get('verdict'))} -- "
                f'"{clean_text(claim.get("said"))}"'
            )
    sentences = receipt.get("sentences")
    if isinstance(sentences, list) and sentences:
        print(f"  Say: {clean_text('; '.join(map(str, sentences)))}")


def print_detail(job: dict[str, Any]) -> None:
    print_field("Job ID", job.get("job_id"))
    print_field("State", job.get("state"))
    print_field("Summary", job.get("summary"))
    print_field("Worker pane", "running" if job.get("window_alive") else "stopped")
    print_field("Created", job.get("created_at"))
    print_field("Archived", job.get("archived_at"))
    print_field("Owner session", job.get("owner_session"))
    print_field("Workflow ID", job.get("workflow_id"))
    print_field("Root job", job.get("root_job"))
    print_field("Parent job", job.get("parent_job"))
    print_field("Project", job.get("project") or "general")
    print_field("Project root", job.get("project_root"))
    print_field("Workspace", job.get("workspace"))
    print_field("Working directory", job.get("working_directory"))
    print_field("Feature", job.get("feature"))
    print_field("Landing branch", job.get("landing_branch"))
    print_field("Review of", job.get("review_of"))
    print_field("Harness", job.get("harness"))
    print_field("Model", job.get("model"))
    print_field("Thinking", job.get("thinking"))
    print_field("Context fingerprint", job.get("context_fingerprint"))
    print_field("Execution generation", job.get("generation"))
    print_field("Event offset", job.get("event_offset"))
    print_field("Execution state", job.get("execution_state"))
    print_field("Tmux session", job.get("tmux_session_name"))
    print_field("Tmux session ID", job.get("tmux_session_id"))
    print_field("Tmux window ID", job.get("tmux_window_id"))
    print_field("Tmux pane ID", job.get("tmux_pane_id"))
    print("Events:")
    events = job.get("events")
    if isinstance(events, list) and events:
        for event in events:
            print(f"  {clean_text(event)}")
    else:
        print("  (none)")
    print_receipt(job.get("receipt"), job.get("receipt_count"))
    print_block("Report", job.get("report"))
    print_block("Project context", job.get("project_context"))
    print_block("Prompt", job.get("prompt"))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="List all stored Scufris jobs or inspect one job by ID.",
        epilog=(
            "Use 'all' or --all to list every active job; no argument remains an "
            "alias for backward compatibility. Cleanup archives a job instead of "
            "deleting it; use --archived to include archived jobs in the list. ID "
            "prefixes are accepted when unique and always resolve archived jobs "
            "too. Use 'history' with --since for what happened in a window, "
            "archived jobs included, each with the receipt measured about it. "
            "Human table output is stable and identical in terminals and pipes."
        ),
    )
    result.add_argument("command", nargs="?", metavar="all|history|ID")
    result.add_argument(
        "--all", action="store_true", dest="all_flag", help="list every stored job"
    )
    result.add_argument(
        "--archived", action="store_true", help="include archived jobs in the list"
    )
    result.add_argument(
        "--since",
        metavar="TIMESTAMP",
        help="history only: an ISO 8601 moment to list jobs from",
    )
    result.add_argument(
        "--limit",
        type=int,
        metavar="N",
        help="history only: keep at most this many of the newest records",
    )
    result.add_argument("--json", action="store_true", help="print structured JSON")
    return result


def emit_error(error: CliError, *, json_output: bool) -> int:
    if json_output:
        print(json.dumps({"error": str(error)}, sort_keys=True))
    else:
        print(f"scufris-jobs: {error}", file=sys.stderr)
    return 1


def main() -> int:
    argument_parser = parser()
    arguments = argument_parser.parse_args()
    if arguments.all_flag and arguments.command not in (None, "all"):
        argument_parser.error("--all cannot be used with a job ID")
    reading_history = arguments.command == "history"
    list_all = arguments.all_flag or arguments.command in (None, "all")
    if arguments.archived and not list_all:
        argument_parser.error("--archived cannot be used with a job ID")
    if (arguments.since is not None or arguments.limit is not None) and not (
        reading_history
    ):
        argument_parser.error("--since and --limit belong to history")
    try:
        if reading_history:
            result = history(arguments.since, arguments.limit)
            if arguments.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                print_history(result)
            return 0
        if list_all:
            jobs = all_jobs(archived=arguments.archived)
            if arguments.json:
                print(json.dumps({"jobs": jobs}, indent=2, sort_keys=True))
            else:
                print_table(jobs)
            return 0
        job_id = resolve_job_id(arguments.command)
        job = inspect(job_id, full=True)
        if arguments.json:
            print(json.dumps(job, indent=2, sort_keys=True))
        else:
            print_detail(job)
        return 0
    except CliError as error:
        return emit_error(error, json_output=arguments.json)


if __name__ == "__main__":
    raise SystemExit(main())
