#!/usr/bin/env python3

import os
import selectors
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import BinaryIO

MAX_TEXT_BYTES = 1_000
MAX_WAV_BYTES = 64 * 1024 * 1024
MAX_PLAYBACK_SECONDS = 60.0
STOP_GRACE_SECONDS = 0.75

cancelled = False
children: list[subprocess.Popen[bytes]] = []


def fail(message: str, code: int) -> int:
    print(f"speech: {message}", file=sys.stderr)
    return code


def terminate_child(child: subprocess.Popen[bytes]) -> None:
    if child.poll() is not None:
        return
    try:
        child.terminate()
    except ProcessLookupError:
        pass


def request_cancel(_signum: int, _frame: object) -> None:
    global cancelled
    cancelled = True
    for child in reversed(children):
        terminate_child(child)


def stop_children() -> None:
    for child in reversed(children):
        terminate_child(child)

    deadline = time.monotonic() + STOP_GRACE_SECONDS
    while time.monotonic() < deadline:
        if all(child.poll() is not None for child in children):
            break
        time.sleep(0.01)

    for child in reversed(children):
        if child.poll() is None:
            try:
                child.kill()
            except ProcessLookupError:
                pass
    for child in children:
        try:
            child.wait(timeout=STOP_GRACE_SECONDS)
        except subprocess.TimeoutExpired:
            pass


def trusted_file(variable: str, required: bool) -> str | None:
    value = os.environ.get(variable)
    if not value:
        if required:
            raise ValueError(f"{variable} is required")
        return None
    path = Path(value)
    if not path.is_absolute() or not path.is_file():
        raise ValueError(f"{variable} is unavailable")
    return str(path)


def read_text(stream: BinaryIO) -> bytes:
    content = stream.read(MAX_TEXT_BYTES + 1)
    if not content or len(content) > MAX_TEXT_BYTES:
        raise ValueError("input must be bounded non-empty UTF-8")
    text = content.decode("utf-8", errors="strict")
    if any(ord(character) < 32 or ord(character) == 127 for character in text):
        raise ValueError("input contains control characters")
    return content


def valid_wav(content: bytes) -> bool:
    if len(content) < 12 or content[:4] != b"RIFF" or content[8:12] != b"WAVE":
        return False
    if int.from_bytes(content[4:8], "little") + 8 != len(content):
        return False

    found_format = False
    found_audio = False
    offset = 12
    while offset + 8 <= len(content):
        chunk_type = content[offset : offset + 4]
        chunk_size = int.from_bytes(content[offset + 4 : offset + 8], "little")
        chunk_start = offset + 8
        chunk_end = chunk_start + chunk_size
        if chunk_end > len(content):
            return False
        if chunk_type == b"fmt ":
            if chunk_size < 16:
                return False
            channels = int.from_bytes(
                content[chunk_start + 2 : chunk_start + 4], "little"
            )
            sample_rate = int.from_bytes(
                content[chunk_start + 4 : chunk_start + 8], "little"
            )
            bits_per_sample = int.from_bytes(
                content[chunk_start + 14 : chunk_start + 16], "little"
            )
            found_format = channels > 0 and sample_rate > 0 and bits_per_sample > 0
        elif chunk_type == b"data" and chunk_size > 0:
            found_audio = True
        offset = chunk_end + (chunk_size % 2)

    return offset == len(content) and found_format and found_audio


def read_synthesis(
    piper: subprocess.Popen[bytes], text: bytes, deadline: float
) -> tuple[bytes, str | None]:
    if piper.stdin is None or piper.stdout is None:
        return b"", "Piper streams are unavailable"
    try:
        piper.stdin.write(text + b"\n")
        piper.stdin.close()
    except BrokenPipeError:
        pass

    output = bytearray()
    selector = selectors.DefaultSelector()
    selector.register(piper.stdout, selectors.EVENT_READ)
    os.set_blocking(piper.stdout.fileno(), False)
    reached_eof = False
    try:
        while piper.poll() is None or not reached_eof:
            if cancelled:
                return b"", None
            if time.monotonic() >= deadline:
                return b"", "playback timed out"
            for key, _events in selector.select(timeout=0.02):
                try:
                    chunk = os.read(key.fd, 64 * 1024)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    reached_eof = True
                    break
                output.extend(chunk)
                if len(output) > MAX_WAV_BYTES:
                    return b"", "Piper output exceeded the limit"
    finally:
        selector.close()
        piper.stdout.close()
    return bytes(output), None


def run() -> int:
    try:
        validated_text = read_text(sys.stdin.buffer)
        model = trusted_file("SCUFRIS_PIPER_MODEL", required=True)
        config = trusted_file("SCUFRIS_PIPER_CONFIG", required=False)
    except (UnicodeDecodeError, ValueError) as error:
        return fail(str(error), 2)

    piper_command = ["piper", "--model", model or "", "--output_file", "-"]
    if config:
        piper_command[3:3] = ["--config", config]

    try:
        piper = subprocess.Popen(
            piper_command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            shell=False,
        )
    except OSError:
        return fail("Piper is unavailable", 3)
    children.append(piper)

    deadline = time.monotonic() + MAX_PLAYBACK_SECONDS
    wav, synthesis_error = read_synthesis(piper, validated_text, deadline)
    if cancelled:
        stop_children()
        return 130
    if synthesis_error:
        stop_children()
        return fail(
            synthesis_error, 7 if synthesis_error == "playback timed out" else 5
        )
    piper.wait()
    if piper.returncode != 0:
        return fail("Piper failed", 5)
    if not valid_wav(wav):
        return fail("Piper returned invalid WAV", 5)

    try:
        player = subprocess.Popen(
            ["pw-play", "-"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            shell=False,
        )
    except OSError:
        return fail("PipeWire playback is unavailable", 4)
    children.append(player)

    try:
        player.communicate(wav, timeout=max(0.01, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        stop_children()
        return fail("playback timed out", 7)
    if cancelled:
        stop_children()
        return 130
    if player.returncode != 0:
        return fail("PipeWire playback failed", 6)
    return 0


def main() -> int:
    signal.signal(signal.SIGTERM, request_cancel)
    signal.signal(signal.SIGINT, request_cancel)
    try:
        return run()
    finally:
        if any(child.poll() is None for child in children):
            stop_children()


if __name__ == "__main__":
    raise SystemExit(main())
