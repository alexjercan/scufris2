#!/usr/bin/env bash
# Run the working tree's Scufris beside the deployed one.
#
#   scufris-staging up
#   scufris-staging backend
#   scufris-staging frontend NAME
#
# `up` keeps the one-terminal convenience. `backend` and named `frontend`
# processes let several companions share one service. Every foreground command
# owns and stops only the child processes whose PIDs it recorded.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scufris-staging up
       scufris-staging backend
       scufris-staging frontend NAME

up runs one service and one desktop. backend runs only the service. Each
frontend NAME runs one desktop against that backend with a stable, independent
identity and state directory. Ctrl+C stops only that command's processes.

Environment:
  SCUFRIS_STAGING_ROOT     staging root (default: /tmp/scufris-staging)
  SCUFRIS_STAGING_SERVICE  scufris-service binary to run
  SCUFRIS_STAGING_DESKTOP  scufris-desktop binary to run
  SCUFRIS_STAGING_SPEAK    synthesiser to give each companion
  SCUFRIS_DESKTOP_HOTKEY   activation key (default: Super+G)
EOF
}

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
action="${1:-}"
profile=""
case "$action:$#" in
  up:1 | backend:1) ;;
  frontend:2)
    profile="$2"
    if [[ ! "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]]; then
      printf 'scufris-staging: frontend NAME must match [A-Za-z0-9][A-Za-z0-9._-]{0,31}\n' >&2
      exit 2
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  printf 'scufris-staging: XDG_RUNTIME_DIR is required for the sockets\n' >&2
  exit 2
fi

staging="${SCUFRIS_STAGING_ROOT:-/tmp/scufris-staging}"
runtime_dir="$XDG_RUNTIME_DIR/scufris-staging"
projects="$staging/projects"
pi_agent="$staging/pi-agent"
deployed_pi_agent="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"

mkdir -p -- "$staging" "$projects" "$pi_agent" "$staging/state" \
  "$staging/data" "$runtime_dir"
chmod 0700 "$staging" "$pi_agent" "$runtime_dir"

# The backend lock is the backend's lifetime, not the lifetime of every
# frontend. `up` owns it too, so named frontends can attach to either form.
if [[ "$action" == "up" || "$action" == "backend" ]]; then
  exec {backend_lock_fd}>"$staging/backend.lock"
  if ! flock -n "$backend_lock_fd"; then
    printf 'scufris-staging: a staging backend is already running (%s)\n' \
      "$staging/backend.lock" >&2
    exit 3
  fi
else
  exec {backend_probe_fd}>"$staging/backend.lock"
  if flock -n "$backend_probe_fd"; then
    printf 'scufris-staging: no staging backend is running; start nix run .#staging -- backend first\n' >&2
    exit 3
  fi
  exec {backend_probe_fd}>&-

  frontend_root="$staging/frontends/$profile"
  mkdir -p -- "$frontend_root/state" "$frontend_root/data"
  chmod 0700 "$staging/frontends" "$frontend_root" \
    "$frontend_root/state" "$frontend_root/data"
  exec {frontend_lock_fd}>"$frontend_root/frontend.lock"
  if ! flock -n "$frontend_lock_fd"; then
    printf 'scufris-staging: frontend %s is already running (%s)\n' \
      "$profile" "$frontend_root/frontend.lock" >&2
    exit 3
  fi
fi

# A fresh backend root gets a harmless project and an isolated Pi settings
# directory. Frontends can also perform this idempotent setup after a backend
# starts, which keeps command ordering deterministic without shared mutation.
if [[ -z "$(ls -A -- "$projects")" ]]; then
  seed="$projects/hello"
  mkdir -p -- "$seed"
  printf '# hello\n\nA staging project. Nothing here is real work.\n' >"$seed/README.md"
  git -C "$seed" init -q -b master
  git -C "$seed" config user.email "staging@scufris.invalid"
  git -C "$seed" config user.name "Scufris Staging"
  git -C "$seed" add README.md
  git -C "$seed" commit -q -m "Seed the staging project"
  printf 'scufris-staging: seeded %s\n' "$seed"
fi

if [[ ! -e "$pi_agent/settings.json" ]]; then
  if [[ -e "$deployed_pi_agent/auth.json" ]]; then
    ln -sfn -- "$deployed_pi_agent/auth.json" "$pi_agent/auth.json"
  fi
  if [[ -e "$deployed_pi_agent/settings.json" ]]; then
    cp -- "$deployed_pi_agent/settings.json" "$pi_agent/settings.json"
  else
    printf '{}\n' >"$pi_agent/settings.json"
  fi
  if [[ -e "$deployed_pi_agent/models-store.json" ]]; then
    cp -- "$deployed_pi_agent/models-store.json" "$pi_agent/models-store.json"
  fi
  chmod 0600 "$pi_agent/settings.json"
  printf 'scufris-staging: seeded %s\n' "$pi_agent"
fi

service="${SCUFRIS_STAGING_SERVICE:-}"
desktop="${SCUFRIS_STAGING_DESKTOP:-}"
need_service=0
need_desktop=0
[[ "$action" == "up" || "$action" == "backend" ]] && need_service=1
[[ "$action" == "up" || "$action" == "frontend" ]] && need_desktop=1

build_args=()
if ((need_service)) && [[ -z "$service" ]]; then
  service="$root/target/debug/scufris-service"
  build_args+=(--bin scufris-service)
fi
if ((need_desktop)) && [[ -z "$desktop" ]]; then
  desktop="$root/target/debug/scufris-desktop"
  build_args+=(--bin scufris-desktop)
fi
if ((${#build_args[@]})); then
  printf 'scufris-staging: building the working tree\n'
  cargo build --manifest-path "$root/Cargo.toml" "${build_args[@]}"
fi
if ((need_service)) && [[ ! -x "$service" ]]; then
  printf 'scufris-staging: %s is not executable\n' "$service" >&2
  exit 2
fi
if ((need_desktop)) && [[ ! -x "$desktop" ]]; then
  printf 'scufris-staging: %s is not executable\n' "$desktop" >&2
  exit 2
fi

export SCUFRIS_RUNTIME_DIR="$runtime_dir"
export PI_CODING_AGENT_DIR="$pi_agent"
export SCUFRIS_PROJECT_ROOTS="[\"$projects\"]"
export SCUFRIS_SERVICE_AGENT="$root/scripts/scufris-agent"
export SCUFRIS_STT_ENDPOINT="${SCUFRIS_STT_ENDPOINT:-http://127.0.0.1:10301/inference}"

if [[ "$action" == "frontend" ]]; then
  export XDG_STATE_HOME="$frontend_root/state"
  export XDG_DATA_HOME="$frontend_root/data"
  export SCUFRIS_STAGING_FRONTEND="$profile"
  export SCUFRIS_DESKTOP_SURFACE_NAME="$profile"
  export SCUFRIS_DESKTOP_COMMAND_SOCKET="$runtime_dir/desktop-$profile.sock"
else
  export XDG_STATE_HOME="$staging/state"
  export XDG_DATA_HOME="$staging/data"
fi

if ((need_desktop)); then
  export SCUFRIS_DESKTOP_COMMAND_SOCKET="${SCUFRIS_DESKTOP_COMMAND_SOCKET:-$runtime_dir/desktop.sock}"
  export SCUFRIS_DESKTOP_HOTKEY="${SCUFRIS_DESKTOP_HOTKEY:-Super+G}"
  speak="${SCUFRIS_DESKTOP_SPEAK_COMMAND:-${SCUFRIS_STAGING_SPEAK:-}}"
  if [[ -z "$speak" && -n "${SCUFRIS_PIPER_MODEL:-}" && -n "${SCUFRIS_PIPER_CONFIG:-}" ]]; then
    if [[ -x "$root/tools/voice/scufris-speak" ]]; then
      speak="$root/tools/voice/scufris-speak"
    fi
  fi
  if [[ -n "$speak" ]]; then
    if [[ ! -x "$speak" ]]; then
      printf 'scufris-staging: %s is not executable\n' "$speak" >&2
      exit 2
    fi
    export SCUFRIS_DESKTOP_SPEAK_COMMAND="$speak"
  else
    printf 'scufris-staging: no synthesiser, so staging stays silent\n'
  fi
fi

cat <<EOF
scufris-staging: the staging environment
  mode=$action${profile:+:$profile}
  SCUFRIS_STAGING_ROOT=$staging
  XDG_STATE_HOME=$XDG_STATE_HOME
  XDG_DATA_HOME=$XDG_DATA_HOME
  SCUFRIS_RUNTIME_DIR=$SCUFRIS_RUNTIME_DIR
  PI_CODING_AGENT_DIR=$PI_CODING_AGENT_DIR
  SCUFRIS_PROJECT_ROOTS=$SCUFRIS_PROJECT_ROOTS
  SCUFRIS_SERVICE_AGENT=$SCUFRIS_SERVICE_AGENT
  SCUFRIS_STT_ENDPOINT=$SCUFRIS_STT_ENDPOINT
EOF
if ((need_desktop)); then
  cat <<EOF
  SCUFRIS_DESKTOP_HOTKEY=$SCUFRIS_DESKTOP_HOTKEY
  SCUFRIS_DESKTOP_COMMAND_SOCKET=$SCUFRIS_DESKTOP_COMMAND_SOCKET
  SCUFRIS_DESKTOP_SPEAK_COMMAND=${SCUFRIS_DESKTOP_SPEAK_COMMAND:-none}
  desktop=$desktop

scufris-staging: the companion resolves
EOF
  "$desktop" --print-config | sed 's/^/  /'
fi
if ((need_service)); then
  printf '  service=%s\n' "$service"
  printf '\nscufris-staging: reach the backend with\n  SCUFRIS_RUNTIME_DIR=%s scufris-ctl state\n' "$runtime_dir"
fi

service_pid=""
desktop_pid=""
signalled=0
stop_children() {
  local pid
  for pid in "$desktop_pid" "$service_pid"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done
}
# shellcheck disable=SC2329
teardown() {
  signalled=1
  printf '\nscufris-staging: stopping\n'
  stop_children
}
trap teardown INT TERM

if ((need_service)); then
  "$service" &
  service_pid=$!
  printf 'scufris-staging: service pid %d\n' "$service_pid"
fi
if ((need_desktop)); then
  "$desktop" &
  desktop_pid=$!
  printf 'scufris-staging: desktop%s pid %d\n' "${profile:+ $profile}" "$desktop_pid"
fi

wait -n || true
stop_children
status=0
for named in "service:$service_pid" "desktop:$desktop_pid"; do
  name="${named%%:*}"
  pid="${named#*:}"
  [[ -z "$pid" ]] && continue
  child=0
  wait "$pid" || child=$?
  if ((signalled)) && ((child == 143 || child == 130)); then
    continue
  fi
  if ((child != 0)); then
    printf 'scufris-staging: %s exited %d\n' "$name" "$child" >&2
    ((status == 0)) && status=$child
  fi
done
if ((need_desktop)); then
  # The command server normally removes this on a graceful application exit.
  # A terminal teardown stops the process directly, so remove only the exact
  # socket this command assigned to its owned desktop.
  rm -f -- "$SCUFRIS_DESKTOP_COMMAND_SOCKET"
fi
exit "$status"
