#!/usr/bin/env python3
"""Holds one exclusive kernel lock on a Scufris desktop socket, and owns it.

Node has no `flock`, and every lock that can be built from the calls Node does
have is a pathname check followed by a separate mutation. This helper takes the
lock the kernel itself keeps: an advisory exclusive lock on the lock file's
inode.

That inode is the same inode for every name that reaches it - a `.` or `..`
detour, a symlinked parent, a different mount of the same filesystem - and it is
not scoped to a network namespace, so it guards exactly the pathname the caller
is about to change.

The caller does not change it. This process does. A cached "the helper is still
alive" belief cannot transfer ownership: the lock is released the instant this
process ends, and a caller that learns of that later would still be holding a
belief the kernel has already withdrawn. So every mutation of the socket
pathname happens here, in the process that holds the lock, and a mutation this
process cannot perform is one that does not happen at all.

The caller holds the lock by keeping standard input open: closing that pipe, or
dying, releases it. Nothing is ever unlinked, so there is no lock to go stale
and no name a former holder can remove after a successor has taken over.

Usage: scufris-socket-lock LOCK_FILE TIMEOUT_MS

Prints `locked` once the lock is held, then reads one JSON command per line:

    {"command": "claim", "public": PATH, "isolated": PATH}
        link ISOLATED onto PUBLIC, replacing a socket nobody is serving

    {"command": "release", "public": PATH, "device": INT, "inode": INT}
        unlink PUBLIC, but only while it is still that inode

The commands are JSON because a socket path is whatever the person configured
and `XDG_RUNTIME_DIR` is whatever the session set. Either may hold spaces,
quotes, or newlines, and a field delimiter that any of those can be is a
delimiter that loses the path.

Each command is answered with one line: `claimed`, `busy`, `released`, `kept`,
or `error MESSAGE`. Prints `busy` and exits with status 3 if the lock is still
held elsewhere when the timeout runs out.
"""

from __future__ import annotations

import errno
import fcntl
import json
import os
import socket
import sys
import time

BUSY_STATUS = 3
USAGE_STATUS = 2
POLL_SECONDS = 0.02
PROBE_SECONDS = 0.5

# Test seam. When set, the helper reports that it has reached the point right
# before a mutation and waits for the named file to appear, which is how a test
# holds one daemon inside the lock while another tries to take it.
BARRIER_ENV = "SCUFRIS_SOCKET_LOCK_BARRIER"


def acquire(lock_file: str, timeout_ms: int) -> int:
    """Returns the locked descriptor, or raises TimeoutError."""
    # Opened, never unlinked: the descriptor carries the lock, and a file that
    # is never removed cannot be removed from under a successor.
    handle = os.open(lock_file, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    deadline = time.monotonic() + timeout_ms / 1000
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except OSError as error:
            if error.errno not in (errno.EACCES, errno.EAGAIN):
                os.close(handle)
                raise
        if time.monotonic() >= deadline:
            os.close(handle)
            raise TimeoutError
        time.sleep(POLL_SECONDS)


def barrier() -> None:
    """Waits at the test seam, if one is armed."""
    proceed = os.environ.get(BARRIER_ENV)
    if not proceed:
        return
    reached = f"{proceed}.reached"
    with open(reached, "w", encoding="utf-8") as handle:
        handle.write("x")
    until = time.monotonic() + 10
    while not os.path.exists(proceed) and time.monotonic() < until:
        time.sleep(POLL_SECONDS)


def answers(public: str) -> bool:
    """Answers whether a live peer is serving this socket."""
    try:
        if not os.path.exists(public):
            return False
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    except OSError:
        return False
    try:
        probe.settimeout(PROBE_SECONDS)
        probe.connect(public)
        return True
    except OSError:
        return False
    finally:
        probe.close()


def claim(public: str, isolated: str) -> str:
    """Links `isolated` onto `public`, replacing a socket nobody is serving."""
    barrier()
    try:
        os.link(isolated, public)
        return "claimed"
    except FileExistsError:
        pass
    except OSError as error:
        return f"error {error}"
    if answers(public):
        return "busy"
    # The probe took time, and nothing can have taken the pathname during it:
    # taking it needs this lock, and this process is holding it.
    barrier()
    try:
        os.unlink(public)
    except FileNotFoundError:
        pass
    except OSError as error:
        return f"error {error}"
    barrier()
    try:
        os.link(isolated, public)
    except OSError as error:
        return f"error {error}"
    return "claimed"


def release(public: str, device: int, inode: int) -> str:
    """Unlinks `public`, but only while it is still the caller's own socket."""
    try:
        stats = os.stat(public)
    except OSError:
        return "kept"
    if stats.st_dev != device or stats.st_ino != inode:
        return "kept"
    barrier()
    try:
        os.unlink(public)
    except FileNotFoundError:
        return "kept"
    except OSError as error:
        return f"error {error}"
    return "released"


class Malformed(Exception):
    """A command whose fields are not the fields that command needs."""


def path_of(request: dict, field: str) -> str:
    """Returns one pathname field."""
    value = request.get(field)
    if not isinstance(value, str) or not value:
        raise Malformed(f"{field} must be a non-empty string")
    return value


def number_of(request: dict, field: str) -> int:
    """Returns one whole-number field."""
    value = request.get(field)
    if isinstance(value, bool) or not isinstance(value, int):
        raise Malformed(f"{field} must be a whole number")
    return value


def run(line: str) -> str:
    """Runs one command, returning the single line that answers it."""
    try:
        request = json.loads(line)
    except ValueError as error:
        return f"error the command is not JSON: {error}"
    if not isinstance(request, dict):
        return "error the command must be a JSON object"
    command = request.get("command")
    try:
        if command == "claim":
            return claim(path_of(request, "public"), path_of(request, "isolated"))
        if command == "release":
            return release(
                path_of(request, "public"),
                number_of(request, "device"),
                number_of(request, "inode"),
            )
    except Malformed as error:
        return f"error {error}"
    return f"error unknown command {command!r}"


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print(
            f"usage: {os.path.basename(argv[0])} LOCK_FILE TIMEOUT_MS", file=sys.stderr
        )
        return USAGE_STATUS
    try:
        timeout_ms = int(argv[2])
    except ValueError:
        print("TIMEOUT_MS must be a whole number of milliseconds", file=sys.stderr)
        return USAGE_STATUS
    if timeout_ms < 0:
        print("TIMEOUT_MS must not be negative", file=sys.stderr)
        return USAGE_STATUS

    try:
        acquire(argv[1], timeout_ms)
    except TimeoutError:
        print("busy", flush=True)
        return BUSY_STATUS
    except OSError as error:
        print(f"cannot lock {argv[1]}: {error}", file=sys.stderr)
        return 1

    print("locked", flush=True)
    # The caller owns the lock for as long as it keeps this pipe open. Reading
    # to end of file is how this process learns that the caller is finished, or
    # gone. Every command in between is carried out here, by the process the
    # kernel gave the lock to.
    try:
        for line in sys.stdin:
            print(run(line.strip()), flush=True)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
