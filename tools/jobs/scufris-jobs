class JobError(Exception):
    pass


def state_home() -> Path:
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return base / "scufris"


def jobs_root() -> Path:
    return state_home() / "jobs"


def archive_root() -> Path:
    return jobs_root() / ARCHIVE_DIR


def archived_job_dir(job_id: str) -> Path:
    return archive_root() / validate_job_id(job_id)


def job_dir(job_id: str) -> Path:
    # Cleanup moves a finished job into the archive. Active lookups keep using
    # the live directory; only explicit archival readers fall back.
    active = jobs_root() / validate_job_id(job_id)
    if active.exists() or active.is_symlink():
        return active
    archived = archived_job_dir(job_id)
    if archived.is_dir():
        return archived
    return active


@contextlib.contextmanager
def workflow_lock() -> Any:
    root = state_home()
    root.mkdir(parents=True, mode=0o700, exist_ok=True)
    canonical_path(root)
    path = root / "jobs.lock"
    descriptor = os.open(
        path,
        os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
    )
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise JobError("workflow lock is not a regular file")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def validate_job_id(value: Any) -> str:
    if not isinstance(value, str) or not JOB_ID.fullmatch(value):
        raise JobError("invalid job ID")
    return value


def validate_capability(value: Any) -> str:
    if not isinstance(value, str) or not re.fullmatch(r"[a-f0-9]{64}", value):
        raise JobError("invalid report capability")
    return value


def capability_hash(value: str) -> str:
    return hashlib.sha256(value.encode("ascii")).hexdigest()


def load_report_auth(job_id: str) -> dict[str, Any]:
    path = job_dir(job_id) / ".report-auth.json"
    descriptor = open_job_artifact(path, os.O_RDONLY)
    try:
        raw = os.read(descriptor, 1024)
        if os.read(descriptor, 1):
            raise JobError("report authorization record is too large")
    finally:
        os.close(descriptor)
    try:
        value = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise JobError("report authorization record is invalid") from error
    if isinstance(value, dict) and set(value) == {
        "launch_capability_hash",
        "report_capability_hash",
        "trusted_capability_hash",
    }:
        value = {"generation": 0, **value}
    if (
        not isinstance(value, dict)
        or set(value)
        != {
            "generation",
            "launch_capability_hash",
            "report_capability_hash",
            "trusted_capability_hash",
        }
        or not isinstance(value["generation"], int)
        or value["generation"] < 0
        or not isinstance(value["trusted_capability_hash"], str)
        or not re.fullmatch(r"[a-f0-9]{64}", value["trusted_capability_hash"])
        or any(
            value[field] is not None
            and (
                not isinstance(value[field], str)
                or not re.fullmatch(r"[a-f0-9]{64}", value[field])
            )
            for field in ("launch_capability_hash", "report_capability_hash")
        )
    ):
        raise JobError("report authorization record is invalid")
    return value


def authorize_capability(job_id: str, value: Any, trusted: bool) -> None:
    capability = validate_capability(value)
    field = "trusted_capability_hash" if trusted else "report_capability_hash"
    expected = load_report_auth(job_id)[field]
    if not isinstance(expected, str) or not secrets.compare_digest(
        capability_hash(capability), expected
    ):
        raise JobError("report capability does not authorize this job")


def validate_request(
    value: Any, required: set[str], optional: set[str] | None = None
) -> dict[str, Any]:
    allowed_optional = set() if optional is None else optional
    if (
        not isinstance(value, dict)
        or set(value) - required - allowed_optional
        or not required <= set(value)
    ):
        raise JobError("invalid request fields")
    return value


def write_new(path: Path, data: bytes, mode: int) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
    except Exception:
        path.unlink(missing_ok=True)
        raise


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    temporary = path.parent / f".{path.name}-{secrets.token_hex(16)}.tmp"
    try:
        write_new(temporary, data, mode)
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def store_job(record: dict[str, Any]) -> None:
    validate_job_record(record, validate_job_id(record.get("job_id")))
    atomic_write(
        job_dir(record["job_id"]) / "job.json",
        json.dumps(record, sort_keys=True, indent=2).encode() + b"\n",
        0o600,
    )
    os.chmod(job_dir(record["job_id"]) / "job.json", 0o400)


def path_identity(path: Path) -> tuple[str, int, int]:
    canonical = canonical_path(path)
    info = canonical.stat()
    return str(canonical), info.st_dev, info.st_ino


def run(
    argv: list[str],
    *,
    cwd: Path | None = None,
    input_bytes: bytes | None = None,
    check: bool = True,
    timeout: float = 120,
) -> subprocess.CompletedProcess[bytes]:
    result = subprocess.run(
        argv,
        cwd=cwd,
        input=input_bytes,
        capture_output=True,
        check=False,
        timeout=timeout,
    )
    if check and result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip()
        raise JobError(detail or f"command failed: {argv[0]}")
    return result


def canonical_path(path: Path, *, directory: bool = True) -> Path:
    if not path.is_absolute():
        raise JobError("path must be absolute")
    current = Path(path.anchor)
    for part in path.parts[1:]:
        current /= part
        try:
            info = current.lstat()
        except FileNotFoundError:
            if current == path and not directory:
                break
            raise JobError(f"path is unavailable: {path}") from None
        if stat.S_ISLNK(info.st_mode):
            raise JobError(f"symlink paths are not allowed: {path}")
    resolved = path.resolve(strict=directory)
    if resolved != path:
        raise JobError(f"path is not canonical: {path}")
    if directory and not resolved.is_dir():
        raise JobError(f"path is not a directory: {path}")
    return resolved


SERVER_ABSENT = ("no server running", "can't find session", "no sessions")


def tmux(
    argv: list[str],
    *,
    input_bytes: bytes | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[bytes]:
    # Workers share the default tmux server with the foreground session. Only
    # named job sessions are ever killed, so the shared server always survives.
    if any(argument.startswith("kill-server") for argument in argv):
        raise JobError("kill-server is forbidden")
    if any(argument in ("-S", "-L") for argument in argv):
        raise JobError("tmux socket selection is forbidden")
    return run(["tmux", *argv], input_bytes=input_bytes, check=check)


def expanded(path: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(path))).resolve()


def configured_roots() -> list[Path]:
    raw = os.environ.get("SCUFRIS_PROJECT_ROOTS", "[]")
    try:
        values = json.loads(raw)
    except json.JSONDecodeError as error:
        raise JobError("SCUFRIS_PROJECT_ROOTS is invalid JSON") from error
    if not isinstance(values, list) or not all(
        isinstance(item, str) for item in values
    ):
        raise JobError("SCUFRIS_PROJECT_ROOTS must be a string array")
    return [expanded(item) for item in values]


def is_git_root(path: Path) -> bool:
    return (path / ".git").exists()


def discover_projects() -> dict[str, Path]:
    projects: dict[str, Path] = {}
    for configured in configured_roots():
        if not configured.is_dir():
            continue
        candidates = [configured] if is_git_root(configured) else []
        candidates.extend(
            path.parent for path in configured.rglob(".git") if path.parent.is_dir()
        )
        for root in sorted(set(candidates)):
            try:
                relative = root.relative_to(configured.parent)
            except ValueError:
                continue
            project_id = relative.as_posix()
            if PROJECT_ID.fullmatch(project_id):
                projects.setdefault(project_id, root.resolve())
    return projects


def resolve_project(project: Any) -> tuple[str, Path]:
    if not isinstance(project, str) or not PROJECT_ID.fullmatch(project):
        raise JobError("invalid project ID")
    root = discover_projects().get(project)
    if root is None:
        raise JobError(f"unknown project ID: {project}")
    return project, root


def keyword_text(value: Any) -> str:
    # Keywords carry values the orchestrator must reproduce exactly, so they
    # render as flat scalars. Guidance prose carries every judgement.
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        if not value.strip() or len(value) > 200 or not value.isprintable():
            raise ValueError("keyword values must be short printable text")
        return value.strip()
    if isinstance(value, list):
        return ", ".join(keyword_text(item) for item in value)
    raise ValueError("keyword values must be scalars or a list of scalars")


def simple_identifier(value: Any) -> bool:
    return isinstance(value, str) and bool(
        re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", value)
    )


def keyword_lines(scope: str, keywords: Any) -> list[str]:
    # Keywords say how an agent is run. They render one per line so the
    # orchestrator can reproduce each value exactly.
    if not isinstance(keywords, dict):
        raise ValueError(f"{scope} keywords must be a table")
    if "harness" in keywords:
        try:
            selected_adapter(
                keywords["harness"],
                keywords.get("model"),
                keywords.get("thinking"),
            )
        except JobError as error:
            raise ValueError(f"{scope} has an unsupported adapter: {error}") from error
    lines = []
    for label, value in keywords.items():
        if not simple_identifier(label):
            raise ValueError(f"{scope} keyword names must be simple identifiers")
        lines.append(f"{label}: {keyword_text(value)}")
    return lines


def guidance_text(scope: str, value: Any) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{scope} guidance must be nonempty text")
    return value.strip()


def render_menu(project: str, raw: bytes) -> list[str]:
    # The file is a menu of agent types, not a workflow. Conventions are
    # inferred; agents run only when the request names them.
    #
    # Briefings are read here only to be left out. They are scheduled sources,
    # not agents the foreground may start, and a menu that named one would be
    # read as an offer. Their own reader validates them, so a mistake in a
    # briefing table costs the project its briefing and not its agents.
    document = tomllib.loads(raw.decode("utf-8"))
    unexpected = set(document) - {"conventions", "agents", "briefings"}
    if "preferences" in unexpected:
        raise ValueError(
            "the preferences workflow shape was retired; declare conventions and agents tables"
        )
    if unexpected:
        raise ValueError("expected only conventions, agents and briefings tables")
    conventions = document.get("conventions", {})
    agents = document.get("agents", {})
    if not isinstance(conventions, dict):
        raise TypeError("conventions must be a table")
    if not isinstance(agents, dict):
        raise TypeError("agents must be a table")
    if not conventions and not agents and "briefings" not in document:
        raise ValueError("expected at least one convention or agent")
    sections: list[str] = [
        f"# Project context: {project}",
        "",
        f"Configuration fingerprint: {hashlib.sha256(raw).hexdigest()}",
    ]
    if conventions:
        if set(conventions) - {"keywords", "guidance"}:
            raise ValueError("conventions accepts only keywords and guidance")
        sections.extend(
            [
                "",
                "## Conventions",
                "",
                "Infer these when the request does not say. An explicit instruction in the request wins over any of them.",
            ]
        )
        if "keywords" in conventions:
            sections.extend(
                ["", *keyword_lines("conventions", conventions["keywords"])]
            )
        if "guidance" in conventions:
            sections.extend(["", guidance_text("conventions", conventions["guidance"])])
    if agents:
        sections.extend(
            [
                "",
                "## Agents",
                "",
                "This is a menu, not a workflow. Run only the agents this request names, in the order it names them.",
            ]
        )
        for name, entry in agents.items():
            if not simple_identifier(name):
                raise ValueError("agent names must be simple identifiers")
            scope = f"agent {name}"
            if not isinstance(entry, dict) or set(entry) - {
                "description",
                "keywords",
                "guidance",
            }:
                raise ValueError(
                    f"{scope} accepts only description, keywords and guidance"
                )
            description = entry.get("description")
            if (
                not isinstance(description, str)
                or not description.strip()
                or len(description) > 200
                or not description.strip().isprintable()
            ):
                raise ValueError(f"{scope} needs one short printable description line")
            sections.extend(["", f"### {name}", "", description.strip()])
            if "keywords" in entry:
                sections.extend(["", *keyword_lines(scope, entry["keywords"])])
            if "guidance" in entry:
                sections.extend(["", guidance_text(scope, entry["guidance"])])
    sections.extend(
        [
            "",
            "Delegate only to the agents this request names. Never start an agent because the project declares it.",
            "",
        ]
    )
    return sections


def render_context(project: str, source: Path) -> dict[str, Any]:
    if not source.exists():
        return {
            "project": project,
            "configured": False,
            "fingerprint": hashlib.sha256(b"").hexdigest(),
            "markdown": f"# Project context: {project}\n\nNo .scufris.toml was found. Infer the conventions from the request and project instructions, and delegate only to what the request names.\n",
            "diagnostic": None,
        }
    try:
        raw = source.read_bytes()
        return {
            "project": project,
            "configured": True,
            "fingerprint": hashlib.sha256(raw).hexdigest(),
            "markdown": "\n".join(render_menu(project, raw)),
            "diagnostic": None,
        }
    except (
        OSError,
        TypeError,
        UnicodeError,
        tomllib.TOMLDecodeError,
        ValueError,
    ) as error:
        return {
            "project": project,
            "configured": False,
            "fingerprint": hashlib.sha256(b"").hexdigest(),
            "markdown": f"# Project context: {project}\n\nThe project configuration was unusable. Infer the conventions from the request and project instructions, and delegate only to what the request names.\n",
            "diagnostic": f"ignored .scufris.toml: {error}",
        }


def briefing_entry(scope: str, entry: Any) -> dict[str, Any]:
    # A briefing source is described the way an agent is, because the person
    # writing it should not have to learn a second shape. What differs is that
    # nobody chooses it: it is asked on a schedule, so its guidance is what the
    # source is asked and is required rather than optional.
    if not isinstance(entry, dict) or set(entry) - {
        "description",
        "keywords",
        "guidance",
    }:
        raise ValueError(f"{scope} accepts only description, keywords and guidance")
    description = entry.get("description")
    if (
        not isinstance(description, str)
        or not description.strip()
        or len(description) > 200
        or not description.strip().isprintable()
    ):
        raise ValueError(f"{scope} needs one short printable description line")
    keywords = entry.get("keywords", {})
    lines = keyword_lines(scope, keywords)
    try:
        harness, model, thinking = selected_adapter(
            keywords.get("harness"),
            keywords.get("model"),
            keywords.get("thinking"),
        )
    except JobError as error:
        raise ValueError(f"{scope} has an unsupported adapter: {error}") from error
    return {
        "description": description.strip(),
        "guidance": guidance_text(scope, entry.get("guidance")),
        "keywords": lines,
        "harness": harness,
        "model": model,
        "thinking": thinking,
    }


def briefing_sources(profile: str) -> tuple[list[dict[str, Any]], list[dict[str, str]]]:
    """Every project that declares this profile, and why any were passed over."""
    sources: list[dict[str, Any]] = []
    diagnostics: list[dict[str, str]] = []
    for project, root in sorted(discover_projects().items()):
        source = root / ".scufris.toml"
        if not source.is_file():
            continue
        try:
            document = tomllib.loads(source.read_bytes().decode("utf-8"))
            declared = document.get("briefings", {})
            if not isinstance(declared, dict):
                raise ValueError("briefings must be a table")
            entry = declared.get(profile)
            if entry is None:
                continue
            sources.append(
                {
                    "project": project,
                    "project_root": str(root),
                    "profile": profile,
                    **briefing_entry(f"briefing {profile}", entry),
                }
            )
        except (
            OSError,
            TypeError,
            UnicodeError,
            tomllib.TOMLDecodeError,
            ValueError,
        ) as error:
            diagnostics.append(
                {"project": project, "diagnostic": f"ignored .scufris.toml: {error}"}
            )
    return sources, diagnostics


def briefings(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"profile"})
    profile = request["profile"]
    if not simple_identifier(profile):
        raise JobError("invalid briefing profile")
    sources, diagnostics = briefing_sources(profile)
    return {"profile": profile, "sources": sources, "diagnostics": diagnostics}


def projects(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, set())
    return {"projects": sorted(discover_projects())}


def context(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"project"})
    project, root = resolve_project(request["project"])
    return {
        **render_context(project, root / ".scufris.toml"),
        "project_root": str(root),
    }


def selected_adapter(harness: Any, model: Any, thinking: Any) -> tuple[str, str, str]:
    selected_harness = "pi" if harness is None else harness
    if not isinstance(selected_harness, str):
        raise JobError("harness must be pi or claude")
    defaults = {
        "pi": ("openai-codex/gpt-5.6-sol", "medium"),
        "claude": ("opus", "xhigh"),
    }
    if selected_harness not in defaults:
        raise JobError("harness must be pi or claude")
    default_model, default_thinking = defaults[selected_harness]
    selected_model = default_model if model is None else model
    selected_thinking = default_thinking if thinking is None else thinking
    if (
        not isinstance(selected_model, str)
        or not selected_model.strip()
        or len(selected_model) > 200
        or not selected_model.isprintable()
    ):
        raise JobError("invalid model")
    if not isinstance(selected_thinking, str) or selected_thinking not in THINKING:
        raise JobError("invalid thinking level")
    if selected_harness == "pi" and selected_thinking == "max":
        raise JobError("Pi does not support max thinking")
    if selected_harness == "claude" and selected_thinking in {"off", "minimal"}:
        raise JobError("Claude does not support off or minimal thinking")
    return selected_harness, selected_model, selected_thinking


def review_isolation(harness: str, workspace: str) -> dict[str, Any] | None:
    if workspace != "review":
        return None
    return {
        "enforcement": "model-tool-allowlist",
        "filesystem": "not-os-sandboxed",
        "tools": (
            PI_REVIEW_TOOLS.split(",")
            if harness == "pi"
            else CLAUDE_REVIEW_TOOLS.split(",")
        ),
        "trusted_boundary": (
            ["harness-executable"]
            if harness == "pi"
            else ["harness-executable", "managed-claude-policy"]
        ),
    }


def worker_prompt(
    instructions: str,
    context_markdown: str | None,
    review: bool,
    harness: str,
) -> str:
    project_section = (
        f"\n## Project context\n\n{context_markdown.strip()}\n"
        if context_markdown
        else ""
    )
    role = (
        dedent(
            """\
            You are an independent read-only reviewer. Inspect the assigned
            work without mutating files. Report concrete findings with paths
            and lines.
            """
        ).strip()
        if review
        else dedent(
            """\
            You are a bounded worker for one foreground Scufris job. Complete
            only the request below.
            """
        ).strip()
    )
    if review and harness == "claude":
        communication = """## Communication

Return one concrete Markdown review as your final response. Scufris records
that response as the terminal review report. You cannot send progress events
or mutate the implementation workspace. If the review cannot complete, explain
the blocker in the final response. The trusted runtime reports harness failures.
"""
    else:
        reporting = (
            "Call the `scufris_report` tool."
            if harness == "pi"
            else dedent(
                f"""\
                Send reports through `{Path(__file__).with_name("scufris-report")}`.
                Pass the event and one-line summary as arguments and the detailed
                Markdown report on standard input.
                """
            ).strip()
        )
        communication = f"""## Communication

{reporting} Do not modify `status` or `report.md` directly. Each report appends
one status-linked Markdown entry and then its validated event for foreground
Scufris.

Allowed events:

- `working: <summary>` while you are actively doing assigned work. This is the
  only event that keeps you running; report it as often as it is useful.
- `blocked: <summary>` when you cannot continue without mediation.
- `done: <summary>` when the current assignment is complete.

Do not invent another event keyword. You cannot report `failed`; trusted
orchestration generates failure when the harness can no longer work.

`blocked` and `done` both end this execution. Report either one only when you
have nothing further to do, and put everything the next execution needs into
`report.md` first. Do not wait afterwards. Your conversation is preserved:
foreground Scufris inspects the request, project context, prompt, report, and
conversation, then reports the outcome to the user. If the user asks for more,
you resume in this same session with that guidance appended to
`conversation.md`, so do not repeat work you already finished.
"""
    return f"""# Scufris delegated job

{role}

Do not spawn other workers. Read instructions and project-local skills from
your working directory when relevant. On a restarted execution, also read the
adjacent durable `report.md` and `conversation.md` before continuing.
{project_section}
## Request

{instructions.strip()}

{communication}"""


def safe_feature(value: Any, job_id: str) -> str:
    feature = f"scufris-{job_id}" if value is None else value
    if (
        not isinstance(feature, str)
        or len(feature) > 48
        or not FEATURE.fullmatch(feature)
    ):
        raise JobError("invalid feature")
    return feature


def sprout(argv: list[str], cwd: Path) -> subprocess.CompletedProcess[bytes]:
    return run(["sprout", *argv], cwd=cwd)


def execution_session_name(job_id: str, generation: int, token: str) -> str:
    return f"scufris-{job_id}-g{generation}-{token[:16]}"


def prepare_execution(record: dict[str, Any]) -> tuple[dict[str, Any], str]:
    launch_capability = secrets.token_hex(32)
    execution_token = secrets.token_hex(32)
    generation = record["generation"]
    updated = {
        **record,
        "execution_state": "creating",
        "tmux_session_name": execution_session_name(
            record["job_id"], generation, execution_token
        ),
        "tmux_session_id": None,
        "tmux_window_id": None,
        "tmux_pane_id": None,
        "execution_token": execution_token,
    }
    directory = job_dir(record["job_id"])
    auth = load_report_auth(record["job_id"])
    auth.update(
        {
            "generation": generation,
            "launch_capability_hash": capability_hash(launch_capability),
            "report_capability_hash": None,
        }
    )
    atomic_write(
        directory / ".report-auth.json",
        json.dumps(auth, sort_keys=True).encode(),
        0o400,
    )
    atomic_write(directory / ".launch-capability", launch_capability.encode(), 0o400)
    store_job(updated)
    return updated, launch_capability


def start_execution(record: dict[str, Any], launch_capability: str) -> dict[str, Any]:
    validate_workspace_identity(record)
    name = record["tmux_session_name"]
    result = tmux(
        [
            "new-session",
            "-d",
            "-P",
            "-F",
            "#{session_id}\t#{window_id}\t#{pane_id}",
            "-s",
            name,
            "-n",
            f"job-{record['job_id']}",
            "-c",
            record["working_directory"],
            "exec sleep 2147483647",
            ";",
            "set-option",
            "-t",
            name,
            "@scufris_job_id",
            record["job_id"],
            ";",
            "set-option",
            "-t",
            name,
            "@scufris_execution_token",
            record["execution_token"],
            ";",
            "set-option",
            "-t",
            name,
            "@scufris_generation",
            str(record["generation"]),
            ";",
            "set-option",
            "-t",
            name,
            "@scufris_phase",
            "creating",
            ";",
            "set-window-option",
            "-t",
            name,
            "remain-on-exit",
            "on",
        ]
    )
    values = result.stdout.decode().strip().split("\t")
    if len(values) != 3:
        raise JobError("could not record tmux identity")
    updated = {
        **record,
        "tmux_session_id": values[0],
        "tmux_window_id": values[1],
        "tmux_pane_id": values[2],
    }
    store_job(updated)
    tmux(
        [
            "respawn-pane",
            "-k",
            "-t",
            values[2],
            "-c",
            record["working_directory"],
            shlex.join(
                [
                    sys.executable,
                    str(Path(__file__).resolve()),
                    "launch",
                    record["job_id"],
                    launch_capability,
                ]
            ),
            ";",
            "set-option",
            "-t",
            name,
            "@scufris_phase",
            "running",
        ]
    )
    updated = {**updated, "execution_state": "running"}
    store_job(updated)
    return updated


def spawn(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(
        request,
        {"job_id", "instructions", "owner_session", "trusted_capability"},
        {
            "project",
            "project_root",
            "context_markdown",
            "context_fingerprint",
            "harness",
            "model",
            "thinking",
            "workspace",
            "feature",
            "review_of",
        },
    )
    job_id = validate_job_id(request["job_id"])
    instructions = request["instructions"]
    owner_session = request["owner_session"]
    trusted_capability = validate_capability(request["trusted_capability"])
    if (
        not isinstance(instructions, str)
        or not instructions.strip()
        or "\x00" in instructions
    ):
        raise JobError("instructions must be nonempty text")
    if not valid_record_text(owner_session, 512):
        raise JobError("owner session is required")
    if shutil.which("tmux") is None:
        raise JobError("tmux executable not found")
    harness, model, thinking = selected_adapter(
        request.get("harness"), request.get("model"), request.get("thinking")
    )
    if shutil.which(harness) is None:
        raise JobError(f"harness executable not found: {harness}")

    project = request.get("project")
    project_root_value = request.get("project_root")
    context_markdown = request.get("context_markdown")
    context_fingerprint = request.get("context_fingerprint")
    root: Path | None
    root_identity: tuple[str | None, int | None, int | None]
    if project is None:
        if any(
            value is not None
            for value in (project_root_value, context_markdown, context_fingerprint)
        ):
            raise JobError("general jobs cannot include project context")
        root = None
        root_identity = (None, None, None)
    else:
        if (
            not isinstance(project_root_value, str)
            or not isinstance(context_markdown, str)
            or not isinstance(context_fingerprint, str)
            or re.fullmatch(r"[a-f0-9]{64}", context_fingerprint) is None
        ):
            raise JobError("project jobs require a resolved context")
        resolved_project, discovered = resolve_project(project)
        supplied = canonical_path(Path(project_root_value))
        discovered = canonical_path(discovered)
        if resolved_project != project or discovered != supplied:
            raise JobError("project context no longer resolves to the selected project")
        root = supplied
        root_identity = path_identity(root)

    review_of = request.get("review_of")
    source: dict[str, Any] | None = None
    if review_of is not None:
        source = load_job(validate_job_id(review_of))
        source_root = load_job(source["root_job"])
        if source_root["cleanup"] is not None:
            raise JobError("cannot add a reviewer while workflow cleanup is active")
        if (
            source["owner_session"] != owner_session
            or root is None
            or source["project"] != project
            or source["project_root"] != str(root)
        ):
            raise JobError(
                "review job must share the source workflow owner and project"
            )
        workspace = "review"
    else:
        workspace = request.get("workspace", "temporary" if root is None else "project")
    if workspace not in WORKSPACES:
        raise JobError("invalid workspace")
    if root is None and workspace != "temporary":
        raise JobError("general jobs require a temporary workspace")
    if root is not None and workspace == "temporary":
        raise JobError("project jobs require project, sprout, or review workspace")
    if workspace == "review" and source is None:
        raise JobError("review workspace requires a source job")
    feature = (
        safe_feature(request.get("feature"), job_id) if workspace == "sprout" else None
    )

    directory = job_dir(job_id)
    if directory.exists() or directory.is_symlink():
        raise JobError("job already exists")
    root_jobs = jobs_root()
    root_jobs.mkdir(parents=True, mode=0o700, exist_ok=True)
    canonical_path(root_jobs)
    directory.mkdir(mode=0o700)
    fsync_directory(root_jobs)
    working: Path | None = None
    working_identity: tuple[str, int, int] | None = None
    sprout_created = False
    try:
        if workspace == "temporary":
            working = directory / "workspace"
            working.mkdir(mode=0o700)
        elif workspace == "project":
            assert root is not None
            working = root
        elif workspace == "sprout":
            assert root is not None and feature is not None
            sprout(["new", feature], root)
            sprout_created = True
            working = canonical_path(
                Path(sprout(["show", feature], root).stdout.decode().strip())
            )
        else:
            assert source is not None
            working_identity = path_identity(Path(source["working_directory"]))
            working = Path(working_identity[0])
            if working_identity != (
                source["working_directory"],
                source["workspace_device"],
                source["workspace_inode"],
            ):
                raise JobError("review source workspace identity changed")
        assert working is not None
        if working_identity is None:
            working_identity = path_identity(working)
        prompt = worker_prompt(
            instructions, context_markdown, source is not None, harness
        )
        write_new(directory / "prompt.md", prompt.encode(), 0o400)
        write_new(directory / "conversation.md", b"", 0o600)
        if context_markdown is not None:
            write_new(
                directory / "project-context.md", context_markdown.encode(), 0o400
            )
        for name in ("status", "report.md", "report.lock"):
            write_new(directory / name, b"", 0o600)
        write_new(
            directory / ".report-auth.json",
            json.dumps(
                {
                    "generation": 1,
                    "launch_capability_hash": None,
                    "report_capability_hash": None,
                    "trusted_capability_hash": capability_hash(trusted_capability),
                },
                sort_keys=True,
            ).encode(),
            0o400,
        )
        record = {
            "version": RECORD_VERSION,
            "job_id": job_id,
            "owner_session": owner_session,
            "workflow_id": source["workflow_id"] if source else secrets.token_hex(32),
            "root_job": source["root_job"] if source else job_id,
            "parent_job": source["job_id"] if source else None,
            "project": project,
            "project_root": root_identity[0],
            "project_root_device": root_identity[1],
            "project_root_inode": root_identity[2],
            "context_fingerprint": context_fingerprint,
            "workspace": workspace,
            "feature": feature,
            "review_of": review_of,
            "working_directory": working_identity[0],
            "workspace_device": working_identity[1],
            "workspace_inode": working_identity[2],
            "landing_branch": (
                run(["git", "branch", "--show-current"], cwd=root)
                .stdout.decode()
                .strip()
                if root is not None
                else None
            ),
            "harness": harness,
            "harness_session": str(uuid.uuid4()),
            "model": model,
            "thinking": thinking,
            "state": "working",
            "summary": "worker starting",
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "archived_at": None,
            "generation": 1,
            "event_offset": 0,
            "status_device": (directory / "status").stat().st_dev,
            "status_inode": (directory / "status").stat().st_ino,
            "execution_state": None,
            "tmux_session_name": None,
            "tmux_session_id": None,
            "tmux_window_id": None,
            "tmux_pane_id": None,
            "execution_token": None,
            "cleanup": None,
        }
        store_job(record)
        prepared, launch_capability = prepare_execution(record)
        running = start_execution(prepared, launch_capability)
        return {
            "job_id": job_id,
            "state": running["state"],
            "project": project,
            "root_job": running["root_job"],
            "parent_job": running["parent_job"],
            "workflow_id": running["workflow_id"],
            "workspace": workspace,
            "feature": feature,
            "harness": harness,
            "model": model,
            "thinking": thinking,
            "generation": running["generation"],
            "tmux_session": running["tmux_session_name"],
            "status_file": str(directory / "status"),
            "message": "Worker started.",
            "review_isolation": review_isolation(harness, workspace),
        }
    except Exception:
        # A durable record is intentionally retained if execution creation began.
        # Recovery can finish or safely stop it from the pinned ownership intent.
        if not (directory / "job.json").exists():
            if sprout_created and root is not None and feature is not None:
                sprout(["rm", feature], root)
            secure_rmtree(directory)
        raise


def open_regular(path: Path) -> int:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as error:
        raise JobError(f"job artifact is unavailable: {path.name}") from error
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise JobError(f"job artifact is not a regular file: {path.name}")
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def read_descriptor(descriptor: int, maximum: int) -> bytes:
    chunks: list[bytes] = []
    remaining = maximum
    while remaining:
        chunk = os.read(descriptor, min(65536, remaining))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def read_regular(
    path: Path,
    maximum: int,
    *,
    optional: bool = False,
    truncate: bool = False,
) -> bytes | None:
    try:
        descriptor = open_regular(path)
    except JobError:
        if optional:
            try:
                path.lstat()
            except FileNotFoundError:
                return None
            except OSError:
                pass
        raise
    try:
        size = os.fstat(descriptor).st_size
        if size > maximum and not truncate:
            raise JobError(f"job artifact is too large: {path.name}")
        limit = maximum if truncate else maximum + 1
        data = read_descriptor(descriptor, limit)
        if len(data) > maximum:
            raise JobError(f"job artifact is too large: {path.name}")
        return data
    finally:
        os.close(descriptor)


def read_regular_tail(path: Path, maximum: int) -> bytes:
    descriptor = open_regular(path)
    try:
        size = os.fstat(descriptor).st_size
        offset = max(0, size - maximum)
        os.lseek(descriptor, offset, os.SEEK_SET)
        data = read_descriptor(descriptor, maximum)
        if offset and b"\n" in data:
            data = data.split(b"\n", 1)[1]
        elif offset:
            data = b""
        return data
    finally:
        os.close(descriptor)


def valid_record_text(value: Any, maximum: int) -> bool:
    if not isinstance(value, str):
        return False
    try:
        encoded = value.encode("utf-8")
    except UnicodeEncodeError:
        return False
    return 0 < len(encoded) <= maximum and all(
        character.isprintable() for character in value
    )


def validate_job_record(value: Any, job_id: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != JOB_FIELDS:
        raise JobError("job record is invalid")
    if value.get("version") != RECORD_VERSION or value.get("job_id") != job_id:
        raise JobError("job record is invalid")
    for field, maximum in (
        ("owner_session", 512),
        ("workflow_id", 64),
        ("working_directory", 4096),
        ("model", 200),
        ("summary", 500),
    ):
        if not valid_record_text(value.get(field), maximum):
            raise JobError("job record is invalid")
    if re.fullmatch(r"[a-f0-9]{64}", value["workflow_id"]) is None:
        raise JobError("job record is invalid")
    if value.get("root_job") is None or JOB_ID.fullmatch(value["root_job"]) is None:
        raise JobError("job record is invalid")
    parent = value.get("parent_job")
    if parent is not None and (
        not isinstance(parent, str) or JOB_ID.fullmatch(parent) is None
    ):
        raise JobError("job record is invalid")
    project = value.get("project")
    if project is not None and (
        not isinstance(project, str) or PROJECT_ID.fullmatch(project) is None
    ):
        raise JobError("job record is invalid")
    fingerprint = value.get("context_fingerprint")
    if fingerprint is not None and (
        not isinstance(fingerprint, str)
        or re.fullmatch(r"[a-f0-9]{64}", fingerprint) is None
    ):
        raise JobError("job record is invalid")
    workspace = value.get("workspace")
    feature = value.get("feature")
    review_of = value.get("review_of")
    if workspace not in WORKSPACES:
        raise JobError("job record is invalid")
    if feature is not None and (
        not isinstance(feature, str)
        or len(feature) > 48
        or FEATURE.fullmatch(feature) is None
    ):
        raise JobError("job record is invalid")
    if review_of is not None and (
        not isinstance(review_of, str) or JOB_ID.fullmatch(review_of) is None
    ):
        raise JobError("job record is invalid")
    for field in ("working_directory", "project_root"):
        path = value.get(field)
        if path is not None and (
            not valid_record_text(path, 4096)
            or not Path(path).is_absolute()
            or ".." in Path(path).parts
        ):
            raise JobError("job record is invalid")
    landing_branch = value.get("landing_branch")
    if landing_branch is not None and not valid_record_text(landing_branch, 1024):
        raise JobError("job record is invalid")
    harness = value.get("harness")
    thinking = value.get("thinking")
    if (
        harness not in {"pi", "claude"}
        or thinking not in THINKING
        or (harness == "pi" and thinking == "max")
        or (harness == "claude" and thinking in {"off", "minimal"})
        or value.get("state") not in LOGICAL_STATES
    ):
        raise JobError("job record is invalid")
    harness_session = value.get("harness_session")
    if not isinstance(harness_session, str) or UUID4.fullmatch(harness_session) is None:
        raise JobError("job record is invalid")
    created_at = value.get("created_at")
    try:
        parsed = dt.datetime.strptime(created_at, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=dt.timezone.utc
        )
    except (TypeError, ValueError) as error:
        raise JobError("job record is invalid") from error
    if parsed.strftime("%Y-%m-%dT%H:%M:%SZ") != created_at:
        raise JobError("job record is invalid")
    archived_at = value.get("archived_at")
    if archived_at is not None:
        try:
            archived = dt.datetime.strptime(archived_at, "%Y-%m-%dT%H:%M:%SZ").replace(
                tzinfo=dt.timezone.utc
            )
        except (TypeError, ValueError) as error:
            raise JobError("job record is invalid") from error
        if archived.strftime("%Y-%m-%dT%H:%M:%SZ") != archived_at:
            raise JobError("job record is invalid")
        if value.get("execution_state") is not None:
            raise JobError("job record is invalid")
    for field in (
        "project_root_device",
        "project_root_inode",
        "workspace_device",
        "workspace_inode",
    ):
        item = value.get(field)
        if item is not None and (not isinstance(item, int) or item < 0):
            raise JobError("job record is invalid")
    generation = value.get("generation")
    event_offset = value.get("event_offset")
    status_device = value.get("status_device")
    status_inode = value.get("status_inode")
    if not isinstance(generation, int) or generation < 1:
        raise JobError("job record is invalid")
    if not isinstance(event_offset, int) or event_offset < 0:
        raise JobError("job record is invalid")
    if (
        not isinstance(status_device, int)
        or status_device < 0
        or not isinstance(status_inode, int)
        or status_inode < 0
    ):
        raise JobError("job record is invalid")
    execution_state = value.get("execution_state")
    if execution_state not in {None, "creating", "running"}:
        raise JobError("job record is invalid")
    execution_values = [
        value.get("tmux_session_name"),
        value.get("execution_token"),
    ]
    if execution_state is None:
        if any(item is not None for item in execution_values) or any(
            value.get(field) is not None
            for field in ("tmux_session_id", "tmux_window_id", "tmux_pane_id")
        ):
            raise JobError("job record is invalid")
    else:
        if not all(isinstance(item, str) and item for item in execution_values):
            raise JobError("job record is invalid")
        if EXECUTION_SESSION.fullmatch(value["tmux_session_name"]) is None:
            raise JobError("job record is invalid")
        if re.fullmatch(r"[a-f0-9]{64}", value["execution_token"]) is None:
            raise JobError("job record is invalid")
        identities = (
            ("tmux_session_id", r"\$[0-9]+"),
            ("tmux_window_id", r"@[0-9]+"),
            ("tmux_pane_id", r"%[0-9]+"),
        )
        present = [value.get(field) is not None for field, _ in identities]
        if any(present) and not all(present):
            raise JobError("job record is invalid")
        for field, pattern in identities:
            item = value.get(field)
            if item is not None and (
                not isinstance(item, str) or re.fullmatch(pattern, item) is None
            ):
                raise JobError("job record is invalid")
    cleanup = value.get("cleanup")
    if cleanup is not None and (
        not isinstance(cleanup, dict)
        or set(cleanup) != {"action", "subject", "remove_workspace", "revision"}
        or cleanup.get("action") not in {"stop", "land"}
        or not isinstance(cleanup.get("remove_workspace"), bool)
        or (
            cleanup.get("subject") is not None
            and not valid_record_text(cleanup.get("subject"), 500)
        )
        or (
            cleanup.get("revision") is not None
            and (
                not isinstance(cleanup.get("revision"), str)
                or re.fullmatch(r"[a-f0-9]{40,64}", cleanup["revision"]) is None
            )
        )
    ):
        raise JobError("job record is invalid")
    project_consistent = (
        project is None
        and value.get("project_root") is None
        and value.get("project_root_device") is None
        and value.get("project_root_inode") is None
        and fingerprint is None
        and landing_branch is None
        and workspace == "temporary"
        or project is not None
        and value.get("project_root") is not None
        and value.get("project_root_device") is not None
        and value.get("project_root_inode") is not None
        and fingerprint is not None
        and landing_branch is not None
        and workspace != "temporary"
    )
    relation_consistent = (
        (workspace == "sprout") == (feature is not None)
        and (workspace == "review") == (review_of is not None)
        and (review_of is None or review_of == parent)
        and ((value["root_job"] == job_id) == (parent is None))
    )
    if not project_consistent or not relation_consistent:
        raise JobError("job record is invalid")
    return value


def load_job(job_id: str, *, archived: bool = False) -> dict[str, Any]:
    path = job_dir(job_id) / "job.json"
    try:
        raw = read_regular(path, MAX_JOB_RECORD)
        assert raw is not None
        value = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise JobError("job record is invalid") from error
    record = validate_job_record(value, job_id)
    # Cleanup archives a workflow instead of deleting it. Archived records stay
    # readable for history and refuse every operation that would revive them.
    if record["archived_at"] is not None and not archived:
        raise JobError("job is archived")
    return record


def load_legacy_job_for_reporting(job_id: str) -> dict[str, Any]:
    path = job_dir(job_id) / "job.json"
    try:
        raw = read_regular(path, MAX_JOB_RECORD)
        assert raw is not None
        value = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise JobError("job record is invalid") from error
    if (
        not isinstance(value, dict)
        or set(value) != LEGACY_JOB_FIELDS
        or value.get("job_id") != job_id
        or not valid_record_text(value.get("owner_session"), 512)
    ):
        raise JobError("job record is invalid")
    return value


def validate_execution_cwd(job: dict[str, Any]) -> None:
    info = os.stat(".")
    current = canonical_path(Path.cwd())
    if (
        str(current) != job["working_directory"]
        or info.st_dev != job["workspace_device"]
        or info.st_ino != job["workspace_inode"]
    ):
        raise JobError("execution working directory identity changed")


def worker_environment() -> dict[str, str]:
    env = os.environ.copy()
    for variable in (
        "SCUFRIS_ROLE",
        "SCUFRIS_SPEECH",
        "SCUFRIS_CALM",
        "PI_SESSION_ID",
        "PI_SESSION_FILE",
        "PI_PROVIDER",
        "PI_MODEL",
        "PI_REASONING_LEVEL",
        "SCUFRIS_REPORT_CAPABILITY",
    ):
        env.pop(variable, None)
    return env


def launch(job_id: str, launch_capability: str) -> NoReturn:
    job = load_job(job_id)
    capability = validate_capability(launch_capability)
    auth = load_report_auth(job_id)
    expected_launch = auth["launch_capability_hash"]
    if (
        auth["generation"] != job["generation"]
        or not isinstance(expected_launch, str)
        or not secrets.compare_digest(capability_hash(capability), expected_launch)
    ):
        raise JobError("launch capability does not authorize this generation")
    validate_execution_cwd(job)
    directory = job_dir(job_id)
    # Generation 1 opens the pinned prompt. Every later generation restores the
    # same harness session and continues it with the foreground's guidance.
    resuming = job["generation"] > 1
    if resuming:
        prompt = f"Read and follow the new guidance at the end of {directory / 'conversation.md'}"
    else:
        prompt = f"Read and follow {directory / 'prompt.md'}"
    session_dir = directory / "harness-session"
    session_dir.mkdir(mode=0o700, exist_ok=True)
    if job["harness"] == "pi":
        report_extension = (
            Path(__file__).resolve().parents[2]
            / "agent"
            / "extensions"
            / "scufris"
            / "workflow"
            / "worker-report.ts"
        )
        if not report_extension.is_file():
            raise JobError("worker report extension is unavailable")
        # Pi creates the session ID when missing and resumes it when present,
        # so one flag covers the first launch and every restore.
        argv = [
            "pi",
            "--approve",
            "--tui-mode",
            "regular",
            "--model",
            job["model"],
            "--thinking",
            job["thinking"],
            "--extension",
            str(report_extension),
            "--no-extensions",
            "--session-dir",
            str(session_dir),
            "--session-id",
            job["harness_session"],
        ]
        if job["workspace"] == "review":
            argv.extend(["--tools", PI_REVIEW_TOOLS])
        argv.append(prompt)
    elif job["workspace"] == "review":
        argv = [
            "claude",
            "--print",
            "--model",
            job["model"],
            "--effort",
            job["thinking"],
            "--permission-mode",
            "dontAsk",
            "--tools",
            CLAUDE_REVIEW_TOOLS,
            "--disallowed-tools",
            CLAUDE_DENIED_REVIEW_TOOLS,
            "--disable-slash-commands",
            "--strict-mcp-config",
            "--mcp-config",
            '{"mcpServers":{}}',
            "--setting-sources",
            "",
        ]
        argv.extend(
            ["--resume", job["harness_session"]]
            if resuming
            else ["--session-id", job["harness_session"]]
        )
        argv.append(prompt)
    else:
        argv = [
            "claude",
            "--dangerously-skip-permissions",
            "--model",
            job["model"],
            "--effort",
            job["thinking"],
        ]
        # Claude pins the ID on the first launch and restores it by ID after.
        argv.extend(
            ["--resume", job["harness_session"]]
            if resuming
            else ["--session-id", job["harness_session"]]
        )
        argv.append(prompt)
    report_capability = secrets.token_hex(32)
    auth["launch_capability_hash"] = None
    auth["report_capability_hash"] = capability_hash(report_capability)
    atomic_write(
        job_dir(job_id) / ".report-auth.json",
        json.dumps(auth, sort_keys=True).encode(),
        0o400,
    )
    (job_dir(job_id) / ".launch-capability").unlink(missing_ok=True)
    fsync_directory(job_dir(job_id))
    env = worker_environment()
    env["SCUFRIS_ROLE"] = "worker"
    env["SCUFRIS_JOB_ID"] = job_id
    env["SCUFRIS_JOB_GENERATION"] = str(job["generation"])
    capture_review = job["workspace"] == "review" and job["harness"] == "claude"
    if not capture_review:
        env["SCUFRIS_REPORT_CAPABILITY"] = report_capability
    if job["harness"] == "claude":
        env["CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION"] = "false"
    executable = shutil.which(argv[0], path=env.get("PATH"))
    if executable is None:
        raise JobError(f"harness executable not found: {argv[0]}")
    completed = subprocess.run(
        [executable, *argv[1:]],
        env=env,
        check=False,
        stdout=subprocess.PIPE if capture_review else None,
        stderr=subprocess.PIPE if capture_review else None,
    )
    publish_harness_completion(
        job_id,
        job["generation"],
        completed,
        capture_review=capture_review,
    )
    raise SystemExit(completed.returncode)


def execution_snapshot(job: dict[str, Any]) -> dict[str, Any] | None:
    if job["execution_state"] is None:
        return None
    name = job["tmux_session_name"]
    result = tmux(
        [
            "display-message",
            "-p",
            "-t",
            f"={name}:",
            (
                "#{session_name}\t#{session_id}\t#{window_id}\t#{pane_id}\t"
                "#{@scufris_job_id}\t#{@scufris_execution_token}\t"
                "#{@scufris_generation}\t#{@scufris_phase}\t#{pane_dead}"
            ),
        ],
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").lower()
        if any(phrase in detail for phrase in SERVER_ABSENT):
            return None
        raise JobError(detail.strip() or "tmux ownership query failed")
    fields = result.stdout.decode().strip().split("\t")
    if len(fields) != 9:
        raise JobError("tmux ownership response is invalid")
    snapshot = dict(
        zip(
            (
                "name",
                "session_id",
                "window_id",
                "pane_id",
                "job_id",
                "token",
                "generation",
                "phase",
                "pane_dead",
            ),
            fields,
            strict=True,
        )
    )
    expected = {
        "name": name,
        "job_id": job["job_id"],
        "token": job["execution_token"],
        "generation": str(job["generation"]),
    }
    for key, value in expected.items():
        if snapshot[key] != value:
            raise JobError(f"tmux ownership mismatch: {key}")
    for key, field in (
        ("session_id", "tmux_session_id"),
        ("window_id", "tmux_window_id"),
        ("pane_id", "tmux_pane_id"),
    ):
        if job[field] is not None and snapshot[key] != job[field]:
            raise JobError(f"tmux ownership mismatch: {key}")
    return snapshot


def record_snapshot(job: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
    updated = {
        **job,
        "tmux_session_id": snapshot["session_id"],
        "tmux_window_id": snapshot["window_id"],
        "tmux_pane_id": snapshot["pane_id"],
        "execution_state": "running" if snapshot["phase"] == "running" else "creating",
    }
    store_job(updated)
    return updated


def finish_precreated_execution(
    job: dict[str, Any], snapshot: dict[str, Any]
) -> dict[str, Any]:
    validate_workspace_identity(job)
    job = record_snapshot(job, snapshot)
    launch_path = job_dir(job["job_id"]) / ".launch-capability"
    launch_capability = read_bounded_artifact(launch_path, 128).decode("ascii")
    tmux(
        [
            "respawn-pane",
            "-k",
            "-t",
            job["tmux_pane_id"],
            "-c",
            job["working_directory"],
            shlex.join(
                [
                    sys.executable,
                    str(Path(__file__).resolve()),
                    "launch",
                    job["job_id"],
                    launch_capability,
                ]
            ),
            ";",
            "set-option",
            "-t",
            job["tmux_session_name"],
            "@scufris_phase",
            "running",
        ]
    )
    updated = {**job, "execution_state": "running"}
    store_job(updated)
    return updated


def execution_ownership_condition(job: dict[str, Any]) -> str:
    comparisons = [
        f"#{{==:#{{session_name}},{job['tmux_session_name']}}}",
        f"#{{==:#{{session_id}},{job['tmux_session_id']}}}",
        f"#{{==:#{{window_id}},{job['tmux_window_id']}}}",
        f"#{{==:#{{pane_id}},{job['tmux_pane_id']}}}",
        f"#{{==:#{{@scufris_job_id}},{job['job_id']}}}",
        f"#{{==:#{{@scufris_execution_token}},{job['execution_token']}}}",
        f"#{{==:#{{@scufris_generation}},{job['generation']}}}",
    ]
    condition = comparisons[0]
    for comparison in comparisons[1:]:
        condition = "#{&&:" + condition + "," + comparison + "}"
    return condition


SNAPSHOT_UNSET = object()


def stop_execution(
    job: dict[str, Any], snapshot: dict[str, Any] | None | object = SNAPSHOT_UNSET
) -> dict[str, Any]:
    if job["execution_state"] is None:
        return job
    if snapshot is SNAPSHOT_UNSET:
        snapshot = execution_snapshot(job)
    if snapshot is None:
        updated = clear_execution(job)
        store_job(updated)
        return updated
    assert isinstance(snapshot, dict)
    job = record_snapshot(job, snapshot)
    name = job["tmux_session_name"]
    # The default server also runs the foreground session. Only an exact match
    # on a generated worker session name may ever be killed.
    if EXECUTION_SESSION.fullmatch(name) is None:
        raise JobError("refusing to kill a session outside the worker namespace")
    condition = execution_ownership_condition(job)
    result = tmux(
        [
            "if-shell",
            "-F",
            "-t",
            f"={name}:",
            condition,
            f"kill-session -t ={name}",
            "display-message -p scufris-ownership-mismatch",
        ],
        check=False,
    )
    output = result.stdout.decode("utf-8", "replace")
    detail = result.stderr.decode("utf-8", "replace").lower()
    absent = any(phrase in detail for phrase in SERVER_ABSENT)
    if "scufris-ownership-mismatch" in output or (
        result.returncode != 0 and not absent
    ):
        raise JobError("tmux atomic ownership validation refused termination")
    updated = clear_execution(job)
    store_job(updated)
    return updated


def clear_execution(job: dict[str, Any]) -> dict[str, Any]:
    return {
        **job,
        "execution_state": None,
        "tmux_session_name": None,
        "tmux_session_id": None,
        "tmux_window_id": None,
        "tmux_pane_id": None,
        "execution_token": None,
    }


def pane_alive(job: dict[str, Any]) -> bool:
    try:
        snapshot = execution_snapshot(job)
    except JobError:
        return False
    return snapshot is not None and snapshot["pane_dead"] == "0"


def parse_event(line: str) -> dict[str, Any] | None:
    try:
        value = json.loads(line)
    except json.JSONDecodeError:
        return None
    if (
        not isinstance(value, dict)
        or set(value) != {"generation", "event", "summary"}
        or not isinstance(value.get("generation"), int)
        or value["generation"] < 1
        or value.get("event") not in EVENTS
        or not isinstance(value.get("summary"), str)
        or not value["summary"].strip()
        or len(value["summary"].encode("utf-8")) > MAX_EVENT_LINE
        or any(ord(character) < 32 for character in value["summary"])
    ):
        return None
    return value


def event_line(generation: int, event: str, summary: str) -> bytes:
    return (
        json.dumps(
            {"generation": generation, "event": event, "summary": summary},
            ensure_ascii=False,
            separators=(",", ":"),
        ).encode("utf-8")
        + b"\n"
    )


def event_identity(job_id: str, start: int, end: int, raw: bytes) -> str:
    digest = hashlib.sha256(raw).hexdigest()[:24]
    return f"{job_id}:{start}:{end}:{digest}"


def latest_event(
    job_id: str, job: dict[str, Any] | None = None
) -> dict[str, Any] | None:
    current = load_job(job_id) if job is None else job
    descriptor = open_regular(job_dir(job_id) / "status")
    try:
        info = os.fstat(descriptor)
        if (info.st_dev, info.st_ino) != (
            current["status_device"],
            current["status_inode"],
        ):
            raise JobError("status identity changed")
        offset = max(0, info.st_size - MAX_STATUS_DETAIL)
        os.lseek(descriptor, offset, os.SEEK_SET)
        data = read_descriptor(descriptor, MAX_STATUS_DETAIL)
        if offset and b"\n" in data:
            data = data.split(b"\n", 1)[1]
        elif offset:
            data = b""
    finally:
        os.close(descriptor)
    for line in reversed(data.decode("utf-8", "replace").splitlines()):
        parsed = parse_event(line)
        if parsed is not None:
            return parsed
    return None


def write_all(descriptor: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        written = os.write(descriptor, view)
        if written == 0:
            raise JobError("could not write job artifact")
        view = view[written:]


def open_job_artifact(path: Path, flags: int) -> int:
    try:
        descriptor = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as error:
        raise JobError(f"job artifact is unavailable: {path.name}") from error
    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        raise JobError(f"job artifact is not a regular file: {path.name}")
    return descriptor


def read_bounded_artifact(path: Path, maximum: int) -> bytes:
    descriptor = open_job_artifact(path, os.O_RDONLY)
    try:
        data = bytearray()
        while len(data) <= maximum:
            chunk = os.read(descriptor, min(64 * 1024, maximum + 1 - len(data)))
            if not chunk:
                break
            data.extend(chunk)
        if len(data) > maximum:
            raise JobError(f"job artifact is too large: {path.name}")
        return bytes(data)
    finally:
        os.close(descriptor)


def write_report(
    job_id: str,
    event: str,
    summary: str,
    detail: str,
    *,
    legacy: bool = False,
    expected_generation: int | None = None,
) -> None:
    display = f"{event}: {summary}"
    try:
        encoded_display = display.encode("utf-8")
        encoded_detail = detail.encode("utf-8")
    except UnicodeEncodeError as error:
        raise JobError("report must be valid UTF-8 text") from error
    if (
        event not in EVENTS
        or not summary.strip()
        or len(encoded_display) > MAX_EVENT_LINE
        or any(ord(character) < 32 for character in summary)
    ):
        raise JobError("invalid worker event")
    if len(encoded_detail) > MAX_REPORT_DETAIL:
        raise JobError("report detail is too large")
    body = detail.strip()
    if not body:
        raise JobError("report must be nonempty text")
    entry = b"# " + encoded_display + b"\n\n" + body.encode("utf-8") + b"\n"
    if len(entry) > MAX_REPORT_ENTRY:
        raise JobError("report entry is too large")

    directory = job_dir(job_id)
    lock_fd = open_job_artifact(directory / "report.lock", os.O_RDWR)
    temporary = directory / f".report-{secrets.token_hex(16)}.tmp"
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        generation = 0 if legacy else load_job(job_id)["generation"]
        if expected_generation is not None and generation != expected_generation:
            raise JobError("job generation changed before report publication")
        current = read_bounded_artifact(directory / "report.md", MAX_REPORT_FILE)
        updated = current + (b"\n" if current else b"") + entry
        if len(updated) > MAX_REPORT_FILE:
            updated = entry
        temporary_fd = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        try:
            write_all(temporary_fd, updated)
            os.fsync(temporary_fd)
        finally:
            os.close(temporary_fd)
        os.replace(temporary, directory / "report.md")
        fsync_directory(directory)
        status_fd = open_job_artifact(directory / "status", os.O_WRONLY | os.O_APPEND)
        try:
            status_payload = (
                f"{event}: {summary}\n".encode()
                if legacy
                else event_line(generation, event, summary)
            )
            write_all(status_fd, status_payload)
            os.fsync(status_fd)
        finally:
            os.close(status_fd)
    finally:
        temporary.unlink(missing_ok=True)
        os.close(lock_fd)


def publish_harness_completion(
    job_id: str,
    expected_generation: int,
    completed: subprocess.CompletedProcess[bytes],
    *,
    capture_review: bool,
) -> bool:
    with workflow_lock():
        current = load_job(job_id, archived=True)
        if (
            current["archived_at"] is not None
            or current["generation"] != expected_generation
            or current["execution_state"] is None
        ):
            return False
        latest = latest_event(job_id, current)
        if (
            latest is not None
            and latest["generation"] == expected_generation
            and latest["event"] in TERMINAL_EVENTS
        ):
            return False
        if capture_review and completed.returncode == 0:
            assert completed.stdout is not None
            output = completed.stdout.decode("utf-8", "replace").strip()
            if output and len(output.encode("utf-8")) <= MAX_REPORT_DETAIL:
                write_report(
                    job_id,
                    "done",
                    "independent review complete",
                    output,
                    expected_generation=expected_generation,
                )
            else:
                reason = "returned no report" if not output else "report was too large"
                write_report(
                    job_id,
                    "failed",
                    "Claude review output was invalid",
                    f"The read-only Claude reviewer {reason}.",
                    expected_generation=expected_generation,
                )
        else:
            detail = f"Worker harness exited with status {completed.returncode}."
            if capture_review:
                assert completed.stderr is not None
                stderr = completed.stderr.decode("utf-8", "replace").strip()
                if stderr:
                    detail += f"\n\n{stderr[-4000:]}"
            write_report(
                job_id,
                "failed",
                "worker harness exited unexpectedly",
                detail,
                expected_generation=expected_generation,
            )
        return True


def report(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id", "capability", "event", "summary", "report"})
    job_id = validate_job_id(request["job_id"])
    legacy = False
    try:
        job = load_job(job_id)
    except JobError:
        job = load_legacy_job_for_reporting(job_id)
        legacy = True
    authorize_capability(job_id, request["capability"], False)
    auth = load_report_auth(job_id)
    if not legacy and auth["generation"] != job["generation"]:
        raise JobError("report capability belongs to an old generation")
    event, summary, detail = request["event"], request["summary"], request["report"]
    if not isinstance(event, str) or not isinstance(summary, str):
        raise JobError("event and summary must be text")
    if event not in WORKER_EVENTS:
        raise JobError("workers may report only working, blocked, or done")
    if not isinstance(detail, str):
        raise JobError("report must be text")
    write_report(job_id, event, summary, detail, legacy=legacy)
    return {"job_id": job_id, "event": event, "summary": summary}


def failure(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id", "capability", "summary", "report"})
    job_id = validate_job_id(request["job_id"])
    legacy = False
    try:
        load_job(job_id)
    except JobError:
        load_legacy_job_for_reporting(job_id)
        legacy = True
    authorize_capability(job_id, request["capability"], True)
    summary, detail = request["summary"], request["report"]
    if not isinstance(summary, str) or not isinstance(detail, str):
        raise JobError("summary and report must be text")
    write_report(job_id, "failed", summary, detail, legacy=legacy)
    return {"job_id": job_id, "event": "failed", "summary": summary}


def read_events(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"jobs"})
    requested = request["jobs"]
    if not isinstance(requested, list):
        raise JobError("jobs must be an array")
    results: list[dict[str, Any]] = []
    for cursor in requested:
        if not isinstance(cursor, dict) or set(cursor) != {"job_id"}:
            raise JobError("invalid event cursor")
        job_id = validate_job_id(cursor["job_id"])
        job = load_job(job_id)
        path = job_dir(job_id) / "status"
        descriptor = open_regular(path)
        try:
            info = os.fstat(descriptor)
            if (info.st_dev, info.st_ino) != (
                job["status_device"],
                job["status_inode"],
            ):
                raise JobError("status identity changed")
            if job["event_offset"] > info.st_size:
                raise JobError("durable event cursor exceeds status size")
            os.lseek(descriptor, job["event_offset"], os.SEEK_SET)
            chunk = read_descriptor(descriptor, MAX_EVENT_BATCH)
        finally:
            os.close(descriptor)
        events: list[dict[str, Any]] = []
        position = job["event_offset"]
        terminal_seen = False
        for raw in chunk.splitlines(keepends=True):
            if not raw.endswith(b"\n"):
                break
            start = position
            position += len(raw)
            identity = event_identity(job_id, start, position, raw)
            try:
                line = raw[:-1].decode("utf-8", "strict")
            except UnicodeDecodeError:
                line = ""
            parsed = parse_event(line)
            if parsed is None:
                events.append(
                    {
                        "id": identity,
                        "start": start,
                        "end": position,
                        "generation": 0,
                        "type": "invalid",
                        "value": "invalid worker event",
                        "line": line[:200],
                    }
                )
                continue
            if parsed["generation"] == job["generation"] and terminal_seen:
                events.append(
                    {
                        "id": identity,
                        "start": start,
                        "end": position,
                        "generation": parsed["generation"],
                        "type": "invalid",
                        "value": "event followed a terminal generation event",
                        "line": f"{parsed['event']}: {parsed['summary']}",
                    }
                )
                continue
            if parsed["generation"] == job["generation"]:
                job = {**job, "state": parsed["event"], "summary": parsed["summary"]}
                if parsed["event"] in TERMINAL_EVENTS:
                    job = stop_execution(job)
                    terminal_seen = True
                store_job(job)
            events.append(
                {
                    "id": identity,
                    "start": start,
                    "end": position,
                    "generation": parsed["generation"],
                    "type": parsed["event"],
                    "value": parsed["summary"],
                    "line": f"{parsed['event']}: {parsed['summary']}",
                }
            )
        results.append(
            {
                "job_id": job_id,
                "events": events,
                "generation": job["generation"],
                "more": position < info.st_size,
                "window_alive": pane_alive(job),
            }
        )
    return {"jobs": results}


def acknowledge_event(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id", "event_id"})
    job_id = validate_job_id(request["job_id"])
    event_id = request["event_id"]
    if not isinstance(event_id, str):
        raise JobError("invalid event identity")
    job = load_job(job_id)
    descriptor = open_regular(job_dir(job_id) / "status")
    try:
        info = os.fstat(descriptor)
        if (info.st_dev, info.st_ino) != (
            job["status_device"],
            job["status_inode"],
        ):
            raise JobError("status identity changed")
        os.lseek(descriptor, job["event_offset"], os.SEEK_SET)
        raw = bytearray()
        while len(raw) <= MAX_EVENT_LINE:
            character = os.read(descriptor, 1)
            if not character:
                break
            raw.extend(character)
            if character == b"\n":
                break
    finally:
        os.close(descriptor)
    if not raw.endswith(b"\n"):
        raise JobError("event is not durably complete")
    end = job["event_offset"] + len(raw)
    expected = event_identity(job_id, job["event_offset"], end, bytes(raw))
    if not secrets.compare_digest(event_id, expected):
        raise JobError("event acknowledgement is out of order")
    updated = {**job, "event_offset": end}
    store_job(updated)
    return {"job_id": job_id, "event_id": event_id, "offset": end}


def validate_workspace_identity(job: dict[str, Any]) -> Path:
    workspace_identity = path_identity(Path(job["working_directory"]))
    if workspace_identity != (
        job["working_directory"],
        job["workspace_device"],
        job["workspace_inode"],
    ):
        raise JobError("workspace identity changed")
    workspace = Path(workspace_identity[0])
    if job["project"] is not None:
        root_identity = path_identity(Path(job["project_root"]))
        if root_identity != (
            job["project_root"],
            job["project_root_device"],
            job["project_root_inode"],
        ):
            raise JobError("project root identity changed")
        root = Path(root_identity[0])
        resolved_project, configured = resolve_project(job["project"])
        if resolved_project != job["project"] or canonical_path(configured) != root:
            raise JobError("project configuration drifted from the recorded root")
        if job["workspace"] == "sprout":
            shown = canonical_path(
                Path(sprout(["show", job["feature"]], root).stdout.decode().strip())
            )
            if shown != workspace:
                raise JobError("Sprout workspace no longer matches its record")
    return workspace


def append_conversation(job_id: str, message: str) -> None:
    path = job_dir(job_id) / "conversation.md"
    descriptor = open_job_artifact(path, os.O_WRONLY | os.O_APPEND)
    try:
        payload = f"\n## Foreground guidance\n\n{message}\n".encode()
        write_all(descriptor, payload)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def restart_execution(job: dict[str, Any]) -> dict[str, Any]:
    validate_workspace_identity(job)
    if job["execution_state"] is not None:
        job = stop_execution(job)
    restarted = {
        **job,
        "generation": job["generation"] + 1,
        "state": "working",
        "summary": "foreground guidance submitted",
    }
    store_job(restarted)
    prepared, capability = prepare_execution(restarted)
    return start_execution(prepared, capability)


def send(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id", "message"})
    job_id = validate_job_id(request["job_id"])
    message = request["message"]
    if (
        not isinstance(message, str)
        or not message
        or "\n" in message
        or "\r" in message
    ):
        raise JobError("message must be one nonempty line")
    job = load_job(job_id)
    root = load_job(job["root_job"])
    if root["cleanup"] is not None:
        raise JobError("workflow cleanup is active; retry cleanup instead of steering")
    append_conversation(job_id, message)
    # Every worker event except `working` ends its execution, so steering always
    # restores the pinned harness session in a fresh generation and window.
    job = restart_execution(job)
    return {
        "job_id": job_id,
        "sent": True,
        "restarted": True,
        "generation": job["generation"],
        "status_file": str(job_dir(job_id) / "status"),
    }


def inspect(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(
        request,
        {"job_id"},
        {"include_report", "include_context", "include_prompt", "include_conversation"},
    )
    job_id = validate_job_id(request["job_id"])
    job = load_job(job_id, archived=True)
    directory = job_dir(job_id)
    result = {
        key: job.get(key)
        for key in (
            "job_id",
            "owner_session",
            "workflow_id",
            "root_job",
            "parent_job",
            "project",
            "project_root",
            "workspace",
            "feature",
            "review_of",
            "working_directory",
            "landing_branch",
            "harness",
            "model",
            "thinking",
            "state",
            "summary",
            "created_at",
            "archived_at",
            "context_fingerprint",
            "generation",
            "event_offset",
            "status_device",
            "status_inode",
            "execution_state",
            "tmux_session_name",
            "tmux_session_id",
            "tmux_window_id",
            "tmux_pane_id",
        )
    }
    result["window_alive"] = pane_alive(job)
    result["review_isolation"] = review_isolation(job["harness"], job["workspace"])
    status = read_regular_tail(directory / "status", MAX_STATUS_DETAIL).decode(
        "utf-8", errors="replace"
    )
    event_lines = status.splitlines()
    parsed_events = [event for line in event_lines if (event := parse_event(line))]
    result["events"] = [
        f"g{event['generation']} {event['event']}: {event['summary']}"
        for event in parsed_events[-100:]
    ]
    if parsed_events:
        result["state"] = parsed_events[-1]["event"]
        result["summary"] = parsed_events[-1]["summary"]
    for enabled, name, key in (
        (request.get("include_report", False), "report.md", "report"),
        (
            request.get("include_context", False),
            "project-context.md",
            "project_context",
        ),
        (request.get("include_prompt", False), "prompt.md", "prompt"),
        (
            request.get("include_conversation", False),
            "conversation.md",
            "conversation",
        ),
    ):
        if enabled:
            maximum = MAX_REPORT_FILE if name == "report.md" else MAX_REPORT_DETAIL
            data = read_regular(
                directory / name,
                maximum,
                optional=name == "project-context.md",
                truncate=True,
            )
            if data is not None:
                result[key] = data.decode("utf-8", "replace")
    return result


def quick_review_target(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id"})
    job_id = validate_job_id(request["job_id"])
    job = load_job(job_id)
    if job.get("workspace") != "sprout":
        raise JobError("Quick Review requires a Sprout project job")
    cwd = Path(job["working_directory"]).resolve()
    branch = job.get("landing_branch")
    if not cwd.is_dir() or not isinstance(branch, str) or not branch:
        raise JobError("Quick Review job metadata is invalid")
    if run(["git", "status", "--porcelain"], cwd=cwd).stdout.strip():
        raise JobError("Quick Review requires a clean committed workspace")
    base_revision = (
        run(["git", "rev-parse", f"refs/heads/{branch}"], cwd=cwd)
        .stdout.decode()
        .strip()
    )
    revision = run(["git", "rev-parse", "HEAD"], cwd=cwd).stdout.decode().strip()
    if base_revision == revision:
        raise JobError("Quick Review requires a committed change")
    return {
        "job_id": job_id,
        "cwd": str(cwd),
        "default_branch": branch,
        "base_revision": base_revision,
        "revision": revision,
        "state_dir": str(job_dir(job_id) / "quick-review-agent"),
    }


def review_target(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id"})
    job = load_job(validate_job_id(request["job_id"]))
    if job.get("workspace") != "sprout" or not isinstance(
        job.get("landing_branch"), str
    ):
        raise JobError("review requires a Sprout project job")
    return {
        "cwd": job["working_directory"],
        "default_branch": job["landing_branch"],
    }


def secure_rmtree(path: Path) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise JobError(f"refusing unsafe directory removal: {path}")

    def empty(descriptor: int) -> None:
        with os.scandir(descriptor) as entries:
            names = [entry.name for entry in entries]
        for name in names:
            child_info = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            if stat.S_ISDIR(child_info.st_mode) and not stat.S_ISLNK(
                child_info.st_mode
            ):
                child = os.open(
                    name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=descriptor,
                )
                try:
                    empty(child)
                finally:
                    os.close(child)
                os.rmdir(name, dir_fd=descriptor)
            else:
                os.unlink(name, dir_fd=descriptor)

    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        if os.fstat(descriptor).st_ino != info.st_ino:
            raise JobError(f"directory identity changed during cleanup: {path}")
        empty(descriptor)
    finally:
        os.close(descriptor)
    path.rmdir()
    fsync_directory(path.parent)


def all_job_records() -> list[dict[str, Any]]:
    root = jobs_root()
    try:
        canonical_path(root)
    except JobError:
        if not root.exists():
            return []
        raise
    records: list[dict[str, Any]] = []
    with os.scandir(root) as entries:
        for entry in entries:
            if not JOB_ID.fullmatch(entry.name):
                continue
            if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
                raise JobError(f"unsafe job directory: {entry.name}")
            record = load_job(entry.name, archived=True)
            if record["archived_at"] is None:
                records.append(record)
    return records


def workflow_records(selected: dict[str, Any]) -> list[dict[str, Any]]:
    records = [
        record
        for record in all_job_records()
        if record["root_job"] == selected["root_job"]
        and record["workflow_id"] == selected["workflow_id"]
        and record["owner_session"] == selected["owner_session"]
    ]
    by_id = {record["job_id"]: record for record in records}
    root = by_id.get(selected["root_job"])
    if root is None or root["parent_job"] is not None:
        raise JobError("workflow root record is unavailable")
    for record in records:
        parent = record["parent_job"]
        if parent is not None and parent not in by_id and root["cleanup"] is None:
            raise JobError("workflow descendant has an invalid parent")
        if record["project"] != root["project"]:
            raise JobError("workflow descendant project mismatch")
    return records


def graph_depth(record: dict[str, Any], by_id: dict[str, dict[str, Any]]) -> int:
    depth = 0
    parent = record["parent_job"]
    seen = {record["job_id"]}
    while parent is not None:
        if parent in seen:
            raise JobError("workflow graph contains a cycle")
        seen.add(parent)
        depth += 1
        if parent not in by_id:
            break
        parent = by_id[parent]["parent_job"]
    return depth


def remove_sprout_workspace(job: dict[str, Any]) -> None:
    if job["workspace"] != "sprout":
        return
    workspace = Path(job["working_directory"])
    root = canonical_path(Path(job["project_root"]))
    if path_identity(root) != (
        job["project_root"],
        job["project_root_device"],
        job["project_root_inode"],
    ):
        raise JobError("project root identity changed before Sprout removal")
    resolved_project, configured = resolve_project(job["project"])
    if resolved_project != job["project"] or canonical_path(configured) != root:
        raise JobError("project configuration drifted before Sprout removal")
    shown_result = run(["sprout", "show", job["feature"]], cwd=root, check=False)
    if shown_result.returncode != 0:
        if workspace.exists() or workspace.is_symlink():
            raise JobError(
                "Sprout feature is absent but its recorded workspace remains"
            )
        return
    shown = shown_result.stdout.decode().strip()
    if canonical_path(Path(shown)) != canonical_path(workspace):
        raise JobError("Sprout feature points at a different workspace")
    sprout(["rm", job["feature"]], root)


def stop_workflow_executions(records: list[dict[str, Any]]) -> None:
    errors: list[str] = []
    for record in records:
        try:
            stop_execution(record)
        except JobError as error:
            errors.append(f"{record['job_id']}: {error}")
    if errors:
        raise JobError("workflow execution cleanup incomplete: " + "; ".join(errors))


def archive_job(record: dict[str, Any], archived_at: str) -> None:
    job_id = record["job_id"]
    current = load_job(job_id, archived=True)
    if current["archived_at"] is not None:
        return
    if current["execution_state"] is not None:
        raise JobError("job still owns an execution")
    store_job({**current, "archived_at": archived_at})
    active = jobs_root() / job_id
    destination = archived_job_dir(job_id)
    if destination.exists() or destination.is_symlink():
        raise JobError("an archived job already occupies that identity")
    root = archive_root()
    root.mkdir(parents=True, mode=0o700, exist_ok=True)
    canonical_path(root)
    os.rename(active, destination)
    fsync_directory(jobs_root())
    fsync_directory(root)


def cleanup_workflow(selected: dict[str, Any]) -> dict[str, Any]:
    records = workflow_records(selected)
    by_id = {record["job_id"]: record for record in records}
    ordered = sorted(
        records, key=lambda record: graph_depth(record, by_id), reverse=True
    )
    errors: list[str] = []
    stop_workflow_executions(ordered)
    remove_workspace = selected["cleanup"]["remove_workspace"]
    for record in ordered:
        if record["workspace"] == "sprout" and remove_workspace:
            try:
                remove_sprout_workspace(record)
            except (JobError, subprocess.SubprocessError) as error:
                errors.append(f"{record['job_id']}: {error}")
    if errors:
        raise JobError("workflow workspace cleanup incomplete: " + "; ".join(errors))
    root_id = selected["root_job"]
    # Job directories are archival. Cleanup releases the live resources and then
    # marks each record archived so its report and history stay on disk.
    archived_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    removed: list[str] = []
    for record in ordered:
        if record["job_id"] == root_id:
            continue
        try:
            archive_job(record, archived_at)
            removed.append(record["job_id"])
        except (JobError, OSError) as error:
            errors.append(f"{record['job_id']}: {error}")
    if errors:
        raise JobError(
            "workflow record cleanup incomplete; root retained: " + "; ".join(errors)
        )
    archive_job(by_id[root_id], archived_at)
    removed.append(root_id)
    return {"root_job": root_id, "removed_jobs": removed, "clean": True}


def land(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id", "subject"}, {"remove_workspace"})
    job_id = validate_job_id(request["job_id"])
    subject = request["subject"]
    if not isinstance(subject, str) or not subject.strip() or "\n" in subject:
        raise JobError("landing subject must be one nonempty line")
    remove_workspace = request.get("remove_workspace", True)
    if not isinstance(remove_workspace, bool):
        raise JobError("remove_workspace must be true or false")
    selected = load_job(job_id)
    root = load_job(selected["root_job"])
    if root["workspace"] != "sprout":
        raise JobError("landing requires a Sprout workflow root")
    if root["cleanup"] is None:
        cwd = validate_workspace_identity(root)
        revision = run(["git", "rev-parse", "HEAD"], cwd=cwd).stdout.decode().strip()
        intent = {
            "action": "land",
            "subject": subject,
            "remove_workspace": remove_workspace,
            "revision": revision,
        }
        root = {**root, "cleanup": intent}
        store_job(root)
    else:
        intent = root["cleanup"]
        if (
            intent["action"] != "land"
            or intent["subject"] != subject
            or intent["remove_workspace"] != remove_workspace
            or not isinstance(intent["revision"], str)
        ):
            raise JobError("a different cleanup operation is already durable")
        revision = intent["revision"]
    stop_workflow_executions(workflow_records(root))
    project_root = canonical_path(Path(root["project_root"]))
    branch = root["landing_branch"]
    already_landed = (
        run(
            ["git", "merge-base", "--is-ancestor", revision, f"refs/heads/{branch}"],
            cwd=project_root,
            check=False,
        ).returncode
        == 0
    )
    if not already_landed and Path(root["working_directory"]).exists():
        feature_tree = run(
            ["git", "rev-parse", f"{revision}^{{tree}}"], cwd=project_root
        ).stdout.strip()
        branch_tree = run(
            ["git", "rev-parse", f"refs/heads/{branch}^{{tree}}"], cwd=project_root
        ).stdout.strip()
        already_landed = feature_tree == branch_tree
    if not already_landed:
        validate_workspace_identity(root)
        sprout(["land", root["feature"], "--dry-run", "-m", subject], project_root)
        sprout(["land", root["feature"], "-m", subject], project_root)
        landed_revision = (
            run(["git", "rev-parse", f"refs/heads/{branch}"], cwd=project_root)
            .stdout.decode()
            .strip()
        )
        root = load_job(root["job_id"])
        root = {**root, "cleanup": {**intent, "revision": landed_revision}}
        store_job(root)
    result = cleanup_workflow(root)
    return {
        "job_id": job_id,
        "landed": True,
        "workspace_removed": remove_workspace,
        **result,
    }


def stop(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"job_id"}, {"remove_workspace"})
    job_id = validate_job_id(request["job_id"])
    remove_workspace = request.get("remove_workspace", False)
    if not isinstance(remove_workspace, bool):
        raise JobError("remove_workspace must be true or false")
    directory = job_dir(job_id)
    if not directory.exists() and not directory.is_symlink():
        return {"job_id": job_id, "state": "stopped", "clean": True, "removed_jobs": []}
    selected = load_job(job_id, archived=True)
    if selected["archived_at"] is not None:
        return {"job_id": job_id, "state": "stopped", "clean": True, "removed_jobs": []}
    # Cleanup is workflow scoped. A descendant ID must never silently escalate
    # into stopping its parent's execution and workspace.
    if selected["job_id"] != selected["root_job"]:
        raise JobError(
            f"stop is workflow scoped; stop the workflow root {selected['root_job']}"
        )
    root = load_job(selected["root_job"])
    intent = {
        "action": "stop",
        "subject": None,
        "remove_workspace": remove_workspace,
        "revision": None,
    }
    if root["cleanup"] is not None and root["cleanup"] != intent:
        raise JobError("a different cleanup operation is already durable")
    root = {**root, "cleanup": intent}
    store_job(root)
    result = cleanup_workflow(root)
    return {"job_id": job_id, "state": "stopped", **result}


def rotate_trusted_capability(job: dict[str, Any]) -> str:
    capability = secrets.token_hex(32)
    auth = load_report_auth(job["job_id"])
    auth["trusted_capability_hash"] = capability_hash(capability)
    atomic_write(
        job_dir(job["job_id"]) / ".report-auth.json",
        json.dumps(auth, sort_keys=True).encode(),
        0o400,
    )
    return capability


def recover_job(job: dict[str, Any]) -> dict[str, Any]:
    root = load_job(job["root_job"])
    if root["cleanup"] is not None:
        if job["execution_state"] is not None:
            job = stop_execution(job)
        job = {
            **job,
            "state": "suspended",
            "summary": "workflow cleanup is incomplete",
        }
        store_job(job)
        return job
    latest = latest_event(job["job_id"], job)
    if (
        latest is not None
        and latest["generation"] == job["generation"]
        and latest["event"] in TERMINAL_EVENTS
    ):
        job = {**job, "state": latest["event"], "summary": latest["summary"]}
    snapshot = execution_snapshot(job) if job["execution_state"] is not None else None
    if job["state"] in TERMINAL_EVENTS:
        if snapshot is not None:
            job = stop_execution(job, snapshot)
        elif job["execution_state"] is not None:
            job = clear_execution(job)
            store_job(job)
        else:
            store_job(job)
    elif job["execution_state"] == "creating":
        if snapshot is None:
            capability = read_bounded_artifact(
                job_dir(job["job_id"]) / ".launch-capability", 128
            ).decode("ascii")
            job = start_execution(job, capability)
        elif snapshot["phase"] == "creating":
            job = finish_precreated_execution(job, snapshot)
        else:
            job = record_snapshot(job, snapshot)
    elif job["execution_state"] == "running":
        if snapshot is None or snapshot["pane_dead"] != "0":
            if snapshot is not None:
                job = stop_execution(job, snapshot)
            else:
                job = clear_execution(job)
                store_job(job)
            write_report(
                job["job_id"],
                "failed",
                "worker execution was lost",
                "Startup reconciliation found no live execution for this logical job.",
            )
            job = {**job, "state": "failed", "summary": "worker execution was lost"}
            store_job(job)
        else:
            job = record_snapshot(job, snapshot)
    elif job["execution_state"] is None and job["state"] in {"working", "blocked"}:
        write_report(
            job["job_id"],
            "failed",
            "execution creation was interrupted",
            "Startup reconciliation found a nonterminal logical job with no owned execution.",
        )
        job = {
            **job,
            "state": "failed",
            "summary": "execution creation was interrupted",
        }
        store_job(job)
    return job


def recover(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"owner_session"})
    owner = request["owner_session"]
    if not valid_record_text(owner, 512):
        raise JobError("owner session must be text")
    recovered: list[dict[str, Any]] = []
    for job in all_job_records():
        if job["owner_session"] != owner:
            continue
        job = recover_job(job)
        capability = rotate_trusted_capability(job)
        recovered.append(
            {
                **{
                    key: job[key]
                    for key in (
                        "job_id",
                        "state",
                        "project",
                        "workspace",
                        "feature",
                        "harness",
                        "model",
                        "thinking",
                        "generation",
                        "tmux_session_name",
                        "root_job",
                        "parent_job",
                        "workflow_id",
                    )
                },
                "tmux_session": job["tmux_session_name"],
                "status_file": str(job_dir(job["job_id"]) / "status"),
                "trusted_capability": capability,
                "summary": job["summary"],
                "window_alive": pane_alive(job),
                "review_isolation": review_isolation(job["harness"], job["workspace"]),
            }
        )
    return {"jobs": recovered}


def suspend_owner(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"owner_session"})
    owner = request["owner_session"]
    errors: list[str] = []
    suspended: list[str] = []
    for job in all_job_records():
        if job["owner_session"] != owner or job["execution_state"] is None:
            continue
        try:
            job = stop_execution(job)
            if job["state"] not in TERMINAL_EVENTS:
                job = {
                    **job,
                    "state": "suspended",
                    "summary": "foreground session stopped",
                }
                store_job(job)
            suspended.append(job["job_id"])
        except JobError as error:
            errors.append(f"{job['job_id']}: {error}")
    return {"job_ids": suspended, "errors": errors}


def orphans(request: dict[str, Any]) -> dict[str, Any]:
    validate_request(request, {"owner_session"})
    owner = request["owner_session"]
    if not isinstance(owner, str):
        raise JobError("owner session must be text")
    return {
        "job_ids": sorted(
            job["job_id"]
            for job in all_job_records()
            if job["owner_session"] != owner and pane_alive(job)
        )
    }


def main() -> int:
    if len(sys.argv) == 4 and sys.argv[1] == "launch":
        launch(validate_job_id(sys.argv[2]), validate_capability(sys.argv[3]))
    if len(sys.argv) != 2:
        raise JobError("use one helper command")
    command = sys.argv[1]
    handlers = {
        "projects": projects,
        "context": context,
        "briefings": briefings,
        "spawn": spawn,
        "events": read_events,
        "ack-event": acknowledge_event,
        "report": report,
        "failure": failure,
        "send": send,
        "inspect": inspect,
        "quick-review-target": quick_review_target,
        "review-target": review_target,
        "land": land,
        "stop": stop,
        "recover": recover,
        "suspend-owner": suspend_owner,
        "orphans": orphans,
    }
    handler = handlers.get(command)
    if handler is None:
        raise JobError("unknown helper command")
    raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
    if len(raw) > MAX_REQUEST:
        raise JobError("request is too large")
    try:
        request = json.loads(raw or b"{}")
    except json.JSONDecodeError as error:
        raise JobError("request is not valid JSON") from error
    mutating = {
        "spawn",
        "events",
        "ack-event",
        "report",
        "failure",
        "send",
        "land",
        "stop",
        "recover",
        "suspend-owner",
    }
    if command in mutating:
        with workflow_lock():
            result = handler(request)
    else:
        result = handler(request)
    print(json.dumps({"ok": True, "result": result}, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except JobError as error:
        print(json.dumps({"ok": False, "error": str(error)}, sort_keys=True))
        raise SystemExit(1)
