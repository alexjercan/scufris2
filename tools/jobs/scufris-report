#!/usr/bin/env python3

import json
import os
import subprocess
import sys
from pathlib import Path

WORKER_EVENTS = {"working", "blocked", "done"}
MAX_REPORT_DETAIL = 512 * 1024


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: scufris-report EVENT SUMMARY < REPORT.md", file=sys.stderr)
        return 2
    if sys.argv[1] not in WORKER_EVENTS:
        print(
            "scufris-report: event must be working, blocked, or done",
            file=sys.stderr,
        )
        return 2
    job_id = os.environ.get("SCUFRIS_JOB_ID")
    capability = os.environ.get("SCUFRIS_REPORT_CAPABILITY")
    if not job_id or not capability:
        print("scufris-report: worker report identity is unavailable", file=sys.stderr)
        return 2
    encoded_report = sys.stdin.buffer.read(MAX_REPORT_DETAIL + 1)
    if len(encoded_report) > MAX_REPORT_DETAIL:
        print("scufris-report: report detail exceeds 512 KiB", file=sys.stderr)
        return 2
    try:
        report = encoded_report.decode("utf-8")
    except UnicodeDecodeError:
        print("scufris-report: report detail must be valid UTF-8", file=sys.stderr)
        return 2
    request = {
        "job_id": job_id,
        "capability": capability,
        "event": sys.argv[1],
        "summary": sys.argv[2],
        "report": report,
    }
    result = subprocess.run(
        [str(Path(__file__).with_name("scufris-jobs")), "report"],
        input=json.dumps(request),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        try:
            error = json.loads(result.stdout).get("error", "report failed")
        except (json.JSONDecodeError, AttributeError):
            error = result.stderr.strip() or "report failed"
        print(f"scufris-report: {error}", file=sys.stderr)
        return result.returncode
    value = json.loads(result.stdout)["result"]
    print(f"appended {value['event']}: {value['summary']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
