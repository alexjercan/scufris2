#!/usr/bin/env python3
"""Run one standalone Quick Review Pi RPC agent and relay its outcome."""

from __future__ import annotations

import json
import os
import re
import signal
import subprocess
import sys
import threading
from pathlib import Path
from typing import Any, BinaryIO

MAX_INIT = 64 * 1024
MAX_RPC_LINE = 4 * 1024 * 1024
MAX_STDERR_TAIL = 4096
PACKAGE = "npm:@alexjercan/quick-review@0.1.1"
SHA = re.compile(r"^[0-9a-f]{40}$")
THINKING = {"off", "minimal", "low", "medium", "high", "xhigh", "max"}


class AgentError(Exception):
    """A bounded standalone-agent failure."""


def read_line(stream: BinaryIO, maximum: int) -> bytes:
    line = stream.readline(maximum + 1)
    if not line:
        raise AgentError("missing Quick Review agent request")
    if len(line) > maximum or not line.endswith(b"\n"):
        raise AgentError("Quick Review agent message is oversized or unterminated")
    return line


def request() -> dict[str, str]:
    try:
        value: Any = json.loads(read_line(sys.stdin.buffer, MAX_INIT))
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise AgentError("Quick Review agent request is invalid") from error
    expected = {
        "repository",
        "base_revision",
        "revision",
        "model",
        "thinking",
        "state_dir",
    }
    if not isinstance(value, dict) or set(value) != expected:
        raise AgentError("Quick Review agent request schema is invalid")
    if any(not isinstance(value[key], str) for key in expected):
        raise AgentError("Quick Review agent request fields must be text")
    repository = Path(value["repository"])
    state_dir = Path(value["state_dir"])
    if not repository.is_absolute() or not repository.is_dir():
        raise AgentError("Quick Review repository is invalid")
    if not state_dir.is_absolute():
        raise AgentError("Quick Review state directory is invalid")
    if not SHA.fullmatch(value["base_revision"]) or not SHA.fullmatch(
        value["revision"]
    ):
        raise AgentError("Quick Review revisions are invalid")
    if value["base_revision"] == value["revision"]:
        raise AgentError("Quick Review revisions must differ")
    if not value["model"] or len(value["model"]) > 200:
        raise AgentError("Quick Review model is invalid")
    if value["thinking"] not in THINKING:
        raise AgentError("Quick Review thinking level is invalid")
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(state_dir, 0o700)
    return value


def emit(value: object) -> None:
    encoded = json.dumps(value, separators=(",", ":"))
    if len(encoded.encode()) > MAX_RPC_LINE:
        raise AgentError("Quick Review agent result is oversized")
    print(encoded, flush=True)


def completion(message: Any, expected: dict[str, str]) -> dict[str, Any] | None:
    if (
        not isinstance(message, dict)
        or message.get("customType") != "quick-review-outcome"
    ):
        return None
    event = message.get("details")
    required = {
        "version",
        "outcome",
        "repository",
        "baseRef",
        "targetRef",
        "baseRevision",
        "revision",
        "identity",
        "sections",
        "comments",
        "overallComment",
        "questions",
        "artifact",
        "state",
        "completedAt",
    }
    if not isinstance(event, dict) or set(event) != required:
        raise AgentError("Quick Review completion schema is invalid")
    if event.get("version") != 1 or event.get("outcome") not in {
        "approved",
        "changes-requested",
    }:
        raise AgentError("Quick Review completion value is invalid")
    if (
        Path(str(event.get("repository"))).resolve()
        != Path(expected["repository"]).resolve()
    ):
        raise AgentError("Quick Review completion repository changed")
    if (
        event.get("baseRevision") != expected["base_revision"]
        or event.get("revision") != expected["revision"]
    ):
        raise AgentError("Quick Review completion revisions changed")
    return event


def stop(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def pi_executable() -> str:
    override = os.environ.get("SCUFRIS_QUICK_REVIEW_PI")
    if override:
        return override
    package = os.environ.get("PI_PACKAGE_DIR")
    if package:
        direct = Path(package) / "dist" / "cli.js"
        if direct.is_file() and os.access(direct, os.X_OK):
            return str(direct)
    return "pi"


def run(value: dict[str, str]) -> int:
    pi = pi_executable()
    argv = [
        pi,
        "--mode",
        "rpc",
        "--no-session",
        "--no-approve",
        "--model",
        value["model"],
        "--thinking",
        value["thinking"],
        "--tools",
        "read,grep,find,ls,quick_review_submit,quick_review_answer",
        "--no-extensions",
        "--extension",
        PACKAGE,
        "--no-skills",
        "--no-prompt-templates",
        "--no-themes",
        "--no-context-files",
    ]
    env = os.environ.copy()
    for key in list(env):
        if key.startswith(("SCUFRIS_", "PI_SESSION_")):
            env.pop(key, None)
    env["QUICK_REVIEW_STATE_DIR"] = value["state_dir"]
    process = subprocess.Popen(
        argv,
        cwd=value["repository"],
        env=env,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    stderr = bytearray()

    def drain_stderr() -> None:
        assert process.stderr is not None
        while chunk := process.stderr.read(4096):
            stderr.extend(chunk)
            if len(stderr) > MAX_STDERR_TAIL:
                del stderr[:-MAX_STDERR_TAIL]

    thread = threading.Thread(
        target=drain_stderr, name="quick-review-agent-stderr", daemon=True
    )
    thread.start()
    previous = signal.getsignal(signal.SIGTERM)
    signal.signal(signal.SIGTERM, lambda _number, _frame: stop(process))
    try:
        assert process.stdin is not None
        prompt = (
            f"/quick-review --base {value['base_revision']} "
            f"--target {value['revision']}"
        )
        process.stdin.write(
            (
                json.dumps({"id": "open-review", "type": "prompt", "message": prompt})
                + "\n"
            ).encode()
        )
        process.stdin.flush()
        assert process.stdout is not None
        ready = False
        while True:
            line = process.stdout.readline(MAX_RPC_LINE + 1)
            if not line:
                break
            if len(line) > MAX_RPC_LINE or not line.endswith(b"\n"):
                raise AgentError("Pi RPC output is oversized or unterminated")
            try:
                event: Any = json.loads(line)
            except (json.JSONDecodeError, UnicodeDecodeError) as error:
                raise AgentError("Pi RPC output is invalid") from error
            if (
                isinstance(event, dict)
                and event.get("type") == "response"
                and event.get("id") == "open-review"
            ):
                if event.get("success") is not True:
                    raise AgentError(
                        str(event.get("error") or "Pi refused Quick Review")
                    )
                ready = True
                emit({"type": "ready"})
                continue
            if isinstance(event, dict) and event.get("type") == "extension_error":
                raise AgentError(
                    str(event.get("error") or "Quick Review extension failed")
                )
            if isinstance(event, dict) and event.get("type") == "message_end":
                result = completion(event.get("message"), value)
                if result is not None:
                    if not ready:
                        raise AgentError(
                            "Quick Review completed before startup was acknowledged"
                        )
                    emit({"type": "completed", "event": result})
                    return 0
        detail = stderr.decode("utf-8", "replace").strip()
        raise AgentError(
            f"Quick Review Pi exited before completion ({process.returncode}): {detail[-1000:]}"
        )
    finally:
        signal.signal(signal.SIGTERM, previous)
        stop(process)
        thread.join(timeout=1)


def main() -> int:
    return run(request())


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AgentError as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
