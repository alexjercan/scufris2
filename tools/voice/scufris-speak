#!/usr/bin/env python3

import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from typing import BinaryIO

MAX_TEXT_BYTES = 1_000
MAX_WAV_BYTES = 64 * 1024 * 1024
API_TIMEOUT_SECONDS = 65.0
MAX_PLAYBACK_SECONDS = 60.0
STOP_GRACE_SECONDS = 0.75
DEFAULT_MODEL = "piper-1"
DEFAULT_VOICE = "en_US-lessac-medium"
SETTING = re.compile(r"[A-Za-z0-9._-]{1,100}")

cancelled = False
children: list[subprocess.Popen[bytes]] = []
response: BinaryIO | None = None


def debug(message: str) -> None:
    directives = os.environ.get("RUST_LOG", "").lower()
    if "debug" in directives or "trace" in directives:
        print(f"speech: debug: {message}", file=sys.stderr)


def fail(message: str, code: int) -> int:
    print(f"speech: {message}", file=sys.stderr)
    return code


def terminate_child(child: subprocess.Popen[bytes]) -> None:
    if child.poll() is not None:
        return
    try:
        child.terminate()
    except ProcessLookupError:
        pass


def request_cancel(_signum: int, _frame: object) -> None:
    global cancelled
    cancelled = True
    if response is not None:
        try:
            response.close()
        except OSError:
            pass
    for child in reversed(children):
        terminate_child(child)


def stop_children() -> None:
    for child in reversed(children):
        terminate_child(child)

    deadline = time.monotonic() + STOP_GRACE_SECONDS
    while time.monotonic() < deadline:
        if all(child.poll() is not None for child in children):
            break
        time.sleep(0.01)

    for child in reversed(children):
        if child.poll() is None:
            try:
                child.kill()
            except ProcessLookupError:
                pass
    for child in children:
        try:
            child.wait(timeout=STOP_GRACE_SECONDS)
        except subprocess.TimeoutExpired:
            pass


def endpoint() -> str:
    value = os.environ.get("SCUFRIS_TTS_ENDPOINT", "")
    parsed = urllib.parse.urlsplit(value)
    if (
        parsed.scheme not in {"http", "https"}
        or not parsed.netloc
        or parsed.username is not None
        or parsed.password is not None
        or parsed.fragment
    ):
        raise ValueError("SCUFRIS_TTS_ENDPOINT must be an HTTP or HTTPS URL")
    return value


def setting(name: str, default: str) -> str:
    value = os.environ.get(name, default)
    if SETTING.fullmatch(value) is None:
        raise ValueError(f"{name} must be a bounded model or voice name")
    return value


def read_text(stream: BinaryIO) -> str:
    content = stream.read(MAX_TEXT_BYTES + 1)
    if not content or len(content) > MAX_TEXT_BYTES:
        raise ValueError("input must be bounded non-empty UTF-8")
    text = content.decode("utf-8", errors="strict")
    if any(ord(character) < 32 or ord(character) == 127 for character in text):
        raise ValueError("input contains control characters")
    return text


def valid_wav(content: bytes) -> bool:
    if len(content) < 12 or content[:4] != b"RIFF" or content[8:12] != b"WAVE":
        return False
    if int.from_bytes(content[4:8], "little") + 8 != len(content):
        return False

    found_format = False
    found_audio = False
    offset = 12
    while offset + 8 <= len(content):
        chunk_type = content[offset : offset + 4]
        chunk_size = int.from_bytes(content[offset + 4 : offset + 8], "little")
        chunk_start = offset + 8
        chunk_end = chunk_start + chunk_size
        if chunk_end > len(content):
            return False
        if chunk_type == b"fmt ":
            if chunk_size < 16:
                return False
            channels = int.from_bytes(
                content[chunk_start + 2 : chunk_start + 4], "little"
            )
            sample_rate = int.from_bytes(
                content[chunk_start + 4 : chunk_start + 8], "little"
            )
            bits_per_sample = int.from_bytes(
                content[chunk_start + 14 : chunk_start + 16], "little"
            )
            found_format = channels > 0 and sample_rate > 0 and bits_per_sample > 0
        elif chunk_type == b"data" and chunk_size > 0:
            found_audio = True
        offset = chunk_end + (chunk_size % 2)

    return offset == len(content) and found_format and found_audio


def synthesize(url: str, text: str, model: str, voice: str) -> tuple[bytes, str | None]:
    global response
    payload = json.dumps(
        {
            "model": model,
            "voice": voice,
            "input": text,
            "response_format": "wav",
        },
        separators=(",", ":"),
    ).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=payload,
        method="POST",
        headers={"Content-Type": "application/json", "Accept": "audio/wav"},
    )
    debug(
        f"POST {url} model={model} voice={voice} input_bytes={len(text.encode('utf-8'))}"
    )
    try:
        response = urllib.request.urlopen(request, timeout=API_TIMEOUT_SECONDS)
        content_type = response.headers.get_content_type()
        declared = response.headers.get("Content-Length")
        if declared is not None and int(declared) > MAX_WAV_BYTES:
            return b"", "synthesis response exceeded the limit"
        output = response.read(MAX_WAV_BYTES + 1)
        if len(output) > MAX_WAV_BYTES:
            return b"", "synthesis response exceeded the limit"
        debug(
            f"response status={response.status} content_type={content_type} wav_bytes={len(output)}"
        )
        if content_type != "audio/wav":
            return b"", "synthesis API returned an unexpected content type"
        return output, None
    except urllib.error.HTTPError as error:
        return b"", f"synthesis API failed with status {error.code}"
    except (OSError, ValueError, urllib.error.URLError):
        return b"", "synthesis API is unavailable"
    finally:
        if response is not None:
            response.close()
            response = None


def run() -> int:
    try:
        text = read_text(sys.stdin.buffer)
        url = endpoint()
        model = setting("SCUFRIS_TTS_MODEL", DEFAULT_MODEL)
        voice = setting("SCUFRIS_TTS_VOICE", DEFAULT_VOICE)
    except (UnicodeDecodeError, ValueError) as error:
        return fail(str(error), 2)

    wav, synthesis_error = synthesize(url, text, model, voice)
    if cancelled:
        stop_children()
        return 130
    if synthesis_error:
        return fail(synthesis_error, 5)
    if not valid_wav(wav):
        return fail("synthesis API returned invalid WAV", 5)

    try:
        player = subprocess.Popen(
            ["pw-play", "-"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            shell=False,
        )
    except OSError:
        return fail("PipeWire playback is unavailable", 4)
    children.append(player)

    try:
        player.communicate(wav, timeout=MAX_PLAYBACK_SECONDS)
    except subprocess.TimeoutExpired:
        stop_children()
        return fail("playback timed out", 7)
    if cancelled:
        stop_children()
        return 130
    if player.returncode != 0:
        return fail("PipeWire playback failed", 6)
    return 0


def main() -> int:
    signal.signal(signal.SIGTERM, request_cancel)
    signal.signal(signal.SIGINT, request_cancel)
    try:
        return run()
    finally:
        if any(child.poll() is None for child in children):
            stop_children()


if __name__ == "__main__":
    raise SystemExit(main())
